  "checks": {
    "jumped": {
      "measure": "jumped",
      "equals": true,
      "expect": "A jump out of the shine",
      "words": "{char} stayed in the shine",
      "headline": "No jump out of the shine",
      "fix": "Press X or Y on frame {4} of the shine or later, while the shine is still out. A jump pressed on frames 1 to {3} is ignored."
    },
    "jump in time": {
      "measure": "jump_frame",
      "at_most": 6,
      "expect": "Jump on frame {4}, {5} or {6}",
      "words": "jumped on frame {measure}",
      "headline": "Late jump",
      "fix": "Press X or Y {3} frames after down-B. Frame {4} is the first frame the shine accepts a jump.",
      "strict": {
        "equals": 4,
        "expect": "Jump on frame {4}",
        "fix": "Press X or Y on frame {4}, {3} frames after down-B: the first frame the shine accepts a jump."
      }
    },
    "air dodged": {
      "measure": "wavedashed",
      "equals": true,
      "expect": "An air dodge into the ground",
      "words": "landed without an air dodge",
      "headline": "No air dodge",
      "fix": "Press L or R on frame {J+4}, the first frame Fox is off the ground, with the stick down and forward. L or R pressed before that is ignored."
    },
    "first airborne frame": {
      "measure": "to_land",
      "at_most": "J+2",
      "expect": "Land within {J+2} frames of the jump",
      "words": "landed {frames} after the jump; frame-perfect is {J}",
      "headline": "Late air dodge",
      "fix": "Press L or R on the frame Fox leaves the ground, {J} frames after the jump. Each frame later, Fox rises higher and lands later.",
      "strict": {
        "equals": "J",
        "expect": "Land {J} frames after the jump",
        "fix": "Press L or R on the frame Fox leaves the ground, {J} frames after the jump: he then lands on that same frame."
      }
    },
    "slide": {
      "measure": "slide",
      "at_least": 10,
      "expect": "A slide of {10} units or more",
      "words": "slid {measure} units",
      "headline": "No slide",
      "fix": "Hold the stick down and forward as you air dodge, not straight down. The closer the stick is to the horizontal, the longer the slide."
    }
  },
