      "happened": {
        "enters": "tumble"
      }
    }
  },
  "verdict": {
    "success": "Out after {hits} of 7 hits; SDI moved {char} {sdi} units."
  },
  "checks": {
    "moved": {
      "measure": "shift",
      "at_least": 5,
      "expect": "Moved by SDI in the first hit's hitlag",
      "words": "moved {measure} units in the first hit's hitlag",
      "headline": "No SDI",
      "fix": "Smash the control stick from the center to the rim during hitlag, after the hit lands. A stick already held when the hit lands, or tilted part way, does not move {char}."
    },
    "smashes": {
      "measure": "sdi",
      "at_least": 10,
      "expect": "SDI moved {char} 10 units or more over the attack",
      "words": "SDI moved {char} {sdi} units over the attack",
      "headline": "Too few SDI inputs",
      "fix": "Smash the stick again on every hit, back to the center between smashes. A stick held still moves {char} once: 6 units."
    },
    "out": {
      "measure": "hits",
      "at_most": 4,
      "expect": "Out of the attack within 4 of its 7 hits",
      "words": "hit {measure} times of 7",
      "headline": "Caught in the attack",
      "fix": "SDI in a direction that leaves the hitboxes. Against this attack up does; away from Pikachu or toward it keeps {char} inside for more hits."
    },
    "not launched": {
      "measure": "launched",
      "equals": false,
      "expect": "Clear of the 7th hit",
      "words": "launched by the 7th hit",
      "headline": "Launched",
      "fix": "Keep smashing until {char} is clear of the attack. Up and away often drifts back beside Pikachu and into the 7th hit; up keeps clear."
    }
  },
