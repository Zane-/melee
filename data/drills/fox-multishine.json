  "checks": {
    "jumped": {
      "measure": "jumped",
      "equals": true,
      "expect": "A jump out of the shine",
      "words": "{char} stayed in the shine",
      "headline": "No jump out of the shine",
      "fix": "Press X or Y on frame {4} of the shine or later, while the shine is still out. A jump pressed on frames 1 to {3} is ignored."
    },
    "jump in time": {
      "measure": "jump_frame",
      "at_most": 6,
      "expect": "Jump on frame {4}, {5} or {6}",
      "words": "jumped on frame {measure}",
      "headline": "Late jump",
      "fix": "Press X or Y {3} frames after down-B. Frame {4} is the first frame the shine accepts a jump.",
      "strict": {
        "equals": 4,
        "expect": "Jump on frame {4}",
        "fix": "Press X or Y on frame {4}, {3} frames after down-B: the first frame the shine accepts a jump."
      }
    },
    "no rise": {
      "measure": "rose",
      "equals": false,
      "expect": "Every shine on the first frame in the air",
      "words": "{char} left the ground without a shine",
      "headline": "Shine missed",
      "fix": "Press down-B {J} frames after each jump, on the frame Fox leaves the ground. Earlier it is ignored; a frame late, Fox has already risen."
    },
    "no double jump": {
      "measure": "double_jumped",
      "equals": false,
      "expect": "No double jump",
      "words": "a jump came while {char} was still in the air",
      "headline": "Double jump",
      "fix": "Wait for the shine to land: jump {5} frames after down-B. Pressed sooner, while the shine is still in the air, the jump is the double jump."
    },
    "three shines": {
      "measure": "shines",
      "at_least": 3,
      "expect": "{3} shines in a row",
      "words": "{measure} shines",
      "headline": "Too few shines",
      "fix": "Down-B {J} frames after each jump, as Fox leaves the ground, and jump {5} frames after each shine, once it has landed. A down-B earlier or later lets Fox rise and ends the chain."
    },
    "five shines": {
      "measure": "shines",
      "at_least": 5,
      "expect": "{5} shines in a row",
      "words": "{measure} shines",
      "headline": "Too few shines",
      "fix": "Down-B {J} frames after each jump, as Fox leaves the ground, and jump {5} frames after each shine, once it has landed. A down-B earlier or later lets Fox rise and ends the chain."
    },
    "steady": {
