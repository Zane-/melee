    "limit": 300
  },
  "measures": {
    "turned": {
      "happened": {
        "enters": "turn",
        "from": "dash"
      }
    },
    "ran": {
      "happened": {
        "enters": "run"
      }
    },
    "pivot": {
      "happened": {
        "leaves": "turn",
        "not_to": "dash"
      }
    },
    "backs": {
      "count": {
        "enters": "dash",
        "from": "turn"
      }
    }
  },
  "verdict": {
    "success": "Pivot: {char} turned around and stopped, facing the other way."
  },
  "checks": {
    "turned": {
      "measure": "turned",
      "equals": true,
      "expect": "A turn out of the dash",
      "words": "no turn during the dash",
      "headline": "No turn",
      "fix": "Flick the stick the other way from the dash's 5th frame, before frame {DASH+1} turns a held dash into a run. It has to pass 0.8 within 2 frames of crossing the center; a slower stick does not turn {char}."
    },
    "no run": {
      "measure": "ran",
      "equals": false,
      "expect": "No run",
      "words": "the dash became a run",
      "headline": "Ran",
      "fix": "Let the stick go or flick it before the dash's frame {DASH+1}. Held toward the dash on that frame, the dash becomes a run, and a run turns around slowly."
    },
    "pivot": {
      "measure": "pivot",
      "equals": true,
      "expect": "A turn that does not lead into a dash back",
      "words": "each turn led into a dash back",
      "headline": "Dashed back",
      "fix": "Let the stick come back under 0.8 on the frame after the turn. Held at full for 2 frames, the flick starts a dash back; one frame at full, then back toward the center, and {char} stands."
    }
  },
