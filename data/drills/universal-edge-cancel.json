{
  "id": "universal-edge-cancel",
  "name": "Edge cancel",
  "part": "tech",
  "characters": "all",
  "goal": "Slide off a platform during an aerial's landing lag",
  "why": "An aerial landed near a platform's edge, with speed toward it, slides {char} off before the landing lag ends. The rest of the landing lag is gone and {char} is in the air, free to act, where the opponent expects {char} to be stuck in lag.",
  "tutorial": {
    "camera": {
      "follow": "player",
      "distance": 120,
      "height": 10
    },
    "what": "An edge cancel is an aerial's landing that slides {char} off the edge of a platform before the landing lag ends.",
    "expect": "Each jump is judged when the landing lag ends or is cut short: whether {char} landed during the aerial, reached the edge, stopped there or slid off.",
    "example": [
      {
        "press": "jump",
        "frame": 1,
        "hold": 1
      },
      {
        "stick": [
          1,
          0
        ],
        "frame": "SPF",
        "hold": "SA-SPF"
      },
      {
        "press": "A",
        "frame": "SA"
      },
      {
        "stick": [
          1,
          0
        ],
        "frame": "SA+1",
        "hold": 60
      }
    ],
    "marks": {
      "SPF": "Frame {SPF}: stick held toward the edge: drift",
      "1": "Frame 1: jump pressed and released",
      "SA": "Frame {SA}: the aerial",
      "NL": "Frame {NL}: landed during the aerial, sliding toward the edge"
    },
    "lessons": [
      {
        "title": "Landing lag slides",
        "text": [
          "Landing lag stops {char} from acting, not from moving: {char} keeps its air speed on landing and slides. Short hop, drift toward the edge from frame {SPF}, and land an aerial close to it.",
          "Keep the stick toward the edge, past 0.75, through the landing: the slide carries {char} off the platform and the rest of the landing lag is gone. Short of 0.75, {char} stops at the edge and teeters."
        ],
        "show": {
          "example": {
            "inputs": [
              {
                "press": "jump",
                "frame": 1,
                "hold": 1
              },
              {
                "stick": [
                  1,
                  0
                ],
                "frame": "SPF",
                "hold": "SA-SPF"
              },
              {
                "press": "A",
                "frame": "SA"
              },
              {
                "stick": [
                  1,
                  0
                ],
                "frame": "SA+1",
                "hold": 60
              }
            ],
            "inputs_for": {
              "mr-game-and-watch": [
                {
                  "press": "jump",
                  "frame": 1,
                  "hold": 1
                },
                {
                  "stick": [
                    1,
                    0
                  ],
                  "frame": "SPF",
                  "hold": 100
                },
                {
                  "cstick": [
                    0,
                    -1
                  ],
                  "frame": "SA"
                }
              ]
            },
            "marks": {
              "SPF": "Frame {SPF}: stick held toward the edge: drift",
              "1": "Frame 1: jump pressed and released",
              "SA": "Frame {SA}: the aerial",
              "NL": "Frame {NL}: landed during the aerial, sliding toward the edge"
            },
            "cues": [
              {
                "frames": [
                  "SPF",
                  "NL-1"
                ],
                "words": "Drift toward the edge",
                "kind": "go"
              },
              {
                "frames": [
                  "NL",
                  "NL+3"
                ],
                "words": "Landing lag: hold toward the edge",
                "kind": "go"
              }
            ]
          }
        }
      }
    ],
    "example_for": {
      "mr-game-and-watch": [
        {
          "press": "jump",
          "frame": 1,
          "hold": 1
        },
        {
          "stick": [
            1,
            0
          ],
          "frame": "SPF",
          "hold": 100
        },
        {
          "cstick": [
            0,
            -1
          ],
          "frame": "SA"
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "Right platform, facing its outer edge",
      "stage": "battlefield",
      "player": {
        "x": "55.5-SPD",
        "above": 40,
        "facing": "right"
      },
      "opponent": "none",
      "camera": {
        "follow": "player",
        "distance": 220,
        "height": 10
      }
    },
    {
      "name": "Left platform, facing its outer edge",
      "stage": "battlefield",
      "player": {
        "x": "-(55.5-SPD)",
        "above": 40,
        "facing": "left"
      },
      "opponent": "none",
      "camera": {
        "follow": "player",
        "distance": 220,
        "height": 10
      }
    }
  ],
  "switch": "success",
  "attempt": {
    "start": {
      "enters": "jump_squat"
    },
    "judge": [
      {
        "leaves": "aerial_landing"
      },
      {
        "enters": "landing"
      },
      {
        "enters": "landing_special"
      },
      {
        "enters": "wait"
      }
    ],
    "cancel": [
      {
        "enters": "grab"
      },
      {
        "enters": "up_smash"
      }
    ],
    "limit": 120,
    "timeout": "judge"
  },
  "measures": {
    "landing_lag": {
      "happened": {
        "enters": "aerial_landing"
      }
    },
    "reached": {
      "happened": [
        {
          "leaves": "aerial_landing",
          "to": "teeter"
        },
        {
          "leaves": "aerial_landing",
          "to": "fall"
        }
      ]
    },
    "teetered": {
      "happened": {
        "enters": "teeter"
      }
    },
    "slid_off": {
      "happened": {
        "leaves": "aerial_landing",
        "to": "fall"
      }
    },
    "on_platform": {
      "frames_while": {
        "in": "aerial_landing"
      },
      "from": {
        "enters": "aerial_landing"
      }
    }
  },
  "verdict": {
    "success": "Edge cancel: off the platform after {on_platform_frames} of landing lag."
  },
  "checks": {
    "with landing lag": {
      "measure": "landing_lag",
      "equals": true,
      "expect": "Land during an aerial",
      "words": "landed with no aerial landing lag",
      "headline": "No landing lag",
      "fix": "Land while the aerial is still going. An aerial that has ended, or that lands in its first or last few frames, has no landing lag."
    },
    "reached the edge": {
      "measure": "reached",
      "equals": true,
      "expect": "Slide to the edge in the landing lag",
      "words": "the slide did not reach the edge",
      "headline": "Short of the edge",
      "fix": "Drift toward the edge as {char} comes down, and land closer to it."
    },
    "not stopped": {
      "measure": "teetered",
      "equals": false,
      "expect": "Stick held toward the edge",
      "words": "teetered, the stick short of 0.75 toward the edge",
      "headline": "Stopped at the edge",
      "fix": "Keep the control stick toward the edge, past 0.75, through the landing. Facing the edge with the stick short of 0.75, {char} stops at the edge."
    },
    "slid off": {
      "measure": "slid_off",
      "equals": true,
      "expect": "Slide off in the landing lag",
      "words": "the landing lag ended on the platform",
      "headline": "Still on the platform",
      "fix": "Land closer to the edge, drifting toward it, with the stick held toward it."
    }
  },
