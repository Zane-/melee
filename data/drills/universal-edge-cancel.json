          "frame": 1,
          "hold": 100
        },
        {
          "cstick": [
            0,
            -1
          ],
          "frame": "SA"
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "Near the edge, facing it",
      "stage": "final-destination",
      "player": {
        "x": "83.5-SHD-(NL-SL)",
        "facing": "right"
      },
      "opponent": "none",
      "camera": {
        "follow": "player",
        "distance": 220,
        "height": 10
      }
    }
  ],
  "attempt": {
    "start": {
      "enters": "jump_squat"
    },
    "judge": [
      {
        "leaves": "aerial_landing"
      },
      {
        "enters": "landing"
      },
      {
        "enters": "landing_special"
      },
      {
        "enters": "wait"
      }
    ],
    "cancel": [
      {
        "enters": "grab"
      },
      {
        "enters": "up_smash"
      }
    ],
    "limit": 120,
    "timeout": "judge"
  },
  "measures": {
    "landing_lag": {
      "happened": {
        "enters": "aerial_landing"
      }
    },
    "reached": {
      "happened": [
        {
          "leaves": "aerial_landing",
          "to": "teeter"
        },
        {
          "leaves": "aerial_landing",
          "to": "fall"
        }
      ]
    },
    "teetered": {
      "happened": {
        "enters": "teeter"
      }
    },
    "slid_off": {
      "happened": {
        "leaves": "aerial_landing",
        "to": "fall"
      }
    },
    "on_stage": {
      "frames_while": {
        "in": "aerial_landing"
      },
      "from": {
        "enters": "aerial_landing"
      }
    }
  },
  "verdict": {
    "success": "Edge cancel: off the edge after {on_stage_frames} of landing lag."
  },
  "checks": {
    "with landing lag": {
      "measure": "landing_lag",
      "equals": true,
      "expect": "Land during an aerial",
      "words": "landed with no aerial landing lag",
      "headline": "No landing lag",
      "fix": "Land while the aerial is still going. An aerial that has ended, or that lands in its first or last few frames, has no landing lag."
    },
    "reached the edge": {
      "measure": "reached",
      "equals": true,
      "expect": "Slide to the edge in the landing lag",
      "words": "the slide did not reach the edge",
      "headline": "Short of the edge",
      "fix": "Drift toward the edge as {char} comes down, and land closer to it."
    },
    "not stopped": {
      "measure": "teetered",
      "equals": false,
      "expect": "Stick held toward the edge",
      "words": "teetered, the stick short of 0.75 toward the edge",
      "headline": "Stopped at the edge",
      "fix": "Keep the control stick toward the edge, past 0.75, through the landing. Facing the edge with the stick short of 0.75, {char} stops at the edge."
    },
    "slid off": {
      "measure": "slid_off",
      "equals": true,
      "expect": "Slide off in the landing lag",
      "words": "the landing lag ended on the stage",
      "headline": "Still on the stage",
      "fix": "Land closer to the edge, drifting toward it, with the stick held toward it."
    }
  },
