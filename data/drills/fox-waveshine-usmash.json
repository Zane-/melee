        ],
        "frame": "JC+J",
        "hold": 2,
        "from": "start"
       },
       {
        "stick": [
         0,
         0
        ],
        "frame": "JC+J+2",
        "hold": 200,
        "from": "start"
       }
      ],
      "marks": {
       "1": "Frame 1: down-B out of the run. The shine hits: {opp} slides away",
       "JC": "Frame {JC}: X or Y out of the shine",
       "JC+J": "Frame {JC+J}: R, the stick toward it and down. Fox slides after it"
      },
      "cues": [
       {
