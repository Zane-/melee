{
 "id": "fox-escape-chaingrab",
 "name": "Escape the chain grab",
 "part": "defense",
 "characters": [
  "fox"
 ],
 "goal": "Get out of a chain grab after the first throw",
 "why": "Thrown at low damage, Fox falls fast and is still in hitstun when the thrower grabs him again: throw after throw, each adding damage. He gets out by acting on the first frame he can, and by turning his flight so that the regrab has further to go.",
 "switch": "success",
 "reset": {
  "after": "quiet",
  "seconds": 1
 },
