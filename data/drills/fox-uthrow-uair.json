{
 "id": "fox-uthrow-uair",
 "name": "Up throw up air",
 "part": "punish",
 "characters": [
  "fox"
 ],
 "goal": "Land the up air after an up throw before the opponent can act, whatever its DI",
 "why": "Fox's up throw leaves a floaty opponent above him in hitstun for about three quarters of a second. He can act well before that: a jump and the up air reach it first, and at high damage the up air takes the stock. The opponent's DI moves where it flies, so Fox has to follow it.",
 "switch": "every",
 "reset": {
  "after": "quiet",
  "seconds": 1
 },
 "tutorial": {
  "what": "Grab with Z, press up to throw, and as soon as Fox can act jump after the opponent and press the C-stick up.",
  "expect": "A try begins with the up throw and is judged when the up air hits or when the opponent has acted: it double jumps away on the first frame its hitstun is over.",
  "example": [
   {
    "press": "Z",
    "frame": 1,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 9,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 11,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 13,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 15,
    "hold": 1
   },
   {
    "stick": [
     "SIDE",
     0
    ],
    "frame": "FREE",
    "hold": 40,
    "from": "start"
   },
   {
    "press": "jump",
    "frame": "JF",
    "hold": 4,
    "from": "start"
   },
   {
    "press": "jump",
    "frame": "DJ",
    "hold": 2,
    "from": "start"
   },
   {
    "cstick": [
     0,
     1
    ],
    "frame": "UA",
    "hold": 2,
    "from": "start"
   }
  ],
  "marks": {
   "1": "Frame 1: the up throw",
   "8": "Frame {f}: {opp} is released, straight up or where its DI sends it",
   "FREE": "Frame {FREE}: Fox can act. Toward where it flies",
   "JF": "Frame {JF}: X or Y, held: a full hop",
   "UA": "Frame {UA}: the C-stick up. The up air"
  },
  "lessons": [
   {
    "title": "The up throw",
    "text": [
     "Fox throws {opp} up on frame 8 of the throw and can act on frame {FREE}. At {PCT}%, {opp} is in hitstun until frame {OVER}.",
     "Those {OVER-FREE} frames are the combo: a jump, and the up air out before they are over."
    ],
    "show": {
     "example": {
      "inputs": [
       {
        "press": "Z",
        "frame": 1,
