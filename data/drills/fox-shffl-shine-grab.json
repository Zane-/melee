  },
  "checks": {
    "short hop": {
      "measure": "kind",
      "equals": "short",
      "expect": "A short hop",
      "words": "a {measure} hop",
      "headline": "Full hop",
      "fix": "Tap X or Y: release it within {J-1} frames."
    },
    "aerial": {
      "measure": "aerial",
      "equals": true,
      "expect": "An aerial",
      "words": "no aerial before landing",
      "headline": "No aerial",
      "fix": "Press A, or tilt the C-stick, once {char} is off the ground, from frame {J+1}. A pressed during the jump squat is not an aerial."
    },
    "fast fall": {
      "measure": "fast_fell",
      "equals": true,
      "expect": "A fast fall",
      "words": "landed without a fast fall",
      "headline": "No fast fall",
      "fix": "Tap the control stick down once {char} starts to fall, from frame {SA} of the short hop. The aerial does not stop a fast fall."
    },
    "l-cancel": {
      "measure": "lag",
      "at_most": 11,
      "expect": "Landing lag halved by an L-cancel",
      "words": "landing lag {frames}",
      "headline": "No L-cancel",
      "fix": "Press L, R or Z on the frame {char} lands or on one of the {6} frames before it. Earlier, or after landing, the full landing lag applies."
    },
    "shined": {
      "measure": "shined",
      "equals": true,
      "expect": "A shine after landing",
      "words": "no shine after landing",
      "headline": "No shine",
      "fix": "Press down-B on the first frame after the landing lag. Down-B pressed during the landing lag is ignored."
    },
    "shine in time": {
      "measure": "shine_gap",
      "at_most": 1,
      "expect": "Shine within {1} frame of the landing lag's end",
      "words": "shine {frames} after the landing lag",
      "headline": "Late shine",
      "fix": "Press down-B on the frame the landing lag ends: {7} frames after landing for an L-cancelled neutral air, {9} for down air."
    },
    "jumped": {
      "measure": "jumped",
      "equals": true,
      "expect": "A jump out of the shine",
      "words": "{char} stayed in the shine",
      "headline": "No jump out of the shine",
      "fix": "Press X or Y on frame {4} of the shine or later, while the shine is still out. A jump pressed on frames 1 to {3} of the shine is ignored."
    },
    "jump in time": {
      "measure": "shine_to_jump",
      "at_most": 5,
      "expect": "Jump on frame {4}, {5} or {6} of the shine",
      "words": "jumped {frames} after the shine",
      "headline": "Late jump",
      "fix": "Press X or Y {3} frames after down-B. Frame {4} of the shine is the first that accepts a jump."
    },
    "grabbed": {
      "measure": "grabbed",
      "equals": true,
      "expect": "A grab out of the jump squat",
      "words": "{char} left the ground without a grab",
      "headline": "No grab",
      "fix": "Press Z {1} or {2} frames after the jump out of the shine, while {char} is still in the jump squat. Z pressed together with that jump is not seen; Z pressed once {char} is in the air is a neutral air."
    }
  },
