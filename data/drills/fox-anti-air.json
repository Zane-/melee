 "id": "fox-anti-air",
 "name": "Anti-air",
 "part": "neutral",
 "characters": [
  "fox"
 ],
 "goal": "Beat a jump-in with an up tilt or an up smash",
 "why": "An opponent in the air has committed to where it lands. Fox's up tilt and up smash both reach above him and come out fast: started as the jump-in arrives, they hit it before its aerial hits him. The up smash is a kill move at high damage.",
 "switch": "success",
 "tutorial": {
  "what": "Stand your ground. When the opponent jumps at Fox, press the C-stick up as it arrives: the up smash. Or tilt the stick up and press A: the up tilt.",
  "expect": "A try begins when the opponent starts an aerial and is judged when Fox's attack hits it, when its aerial hits Fox or his shield, or when it has landed and can act. It only jumps in where an up tilt or an up smash can beat it.",
  "example": [
   {
    "cstick": [
     0,
     1
    ],
    "frame": 1,
    "hold": 2,
    "from": {
     "near": "D",
     "after": "start"
    }
   },
   {
    "cstick": [
