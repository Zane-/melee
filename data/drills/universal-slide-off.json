    },
    "slid off": {
      "measure": "slid_off",
      "equals": true,
      "expect": "Slide off before the landing lag ends",
      "words": "the slide did not reach the edge",
      "headline": "Landing lag ended on the platform",
      "fix": "Air dodge toward the edge, not straight down, so the slide reaches the edge within the 10 frames of landing lag."
    }
  },
