        {
          "pressed": "lcancel"
        },
        "lands"
      ],
      "last": true
    },
    "lag": {
      "frames_while": {
        "in": "aerial_landing"
      },
      "from": "lands"
    }
  },
  "verdict": {
    "success": "SHFFL: {lag_frames} of landing lag, L-cancel pressed {before_frames} before landing."
  },
  "checks": {
    "short hop": {
      "measure": "kind",
      "equals": "short",
      "expect": "A short hop",
      "words": "a {measure} hop",
      "headline": "Full hop",
      "fix": "Release the jump button within {J-1} frames, during jump squat."
    },
    "fast fell": {
      "measure": "fast_fell",
      "equals": true,
      "expect": "A fast fall",
      "words": "landed without one",
      "headline": "No fast fall",
      "fix": "Tap the control stick down once {char} starts to fall, from frame {SA}. A stick that reached down more than 3 frames before the fall began does not count."
    },
    "with landing lag": {
      "measure": "landing_lag",
      "equals": true,
      "expect": "Land during the aerial",
      "words": "landed with no aerial landing lag",
      "headline": "No landing lag to cancel",
      "fix": "Land while the aerial is still going. An aerial that has ended, or that lands in its first or last few frames, has no landing lag."
    },
    "pressed": {
      "measure": "before",
      "at_least": 0,
      "expect": "L, R or Z pressed before landing",
      "words": "no press of L, R or Z up to the landing",
      "headline": "No L-cancel",
      "fix": "Press L, R or Z as {char} comes down: on the landing frame or up to 6 frames before it. A press after the landing does nothing."
    },
    "in time": {
      "measure": "before",
      "at_most": 6,
      "expect": "L, R or Z within 6 frames before landing",
      "words": "pressed {frames} before landing",
      "headline": "L-cancel too early",
      "fix": "Press later. The press counts for the frame it is made and the 6 after it; this one was {frames} before the landing."
    }
  },
