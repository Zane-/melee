      "enters": "illusion",
      "on_ground": true
    },
    "judge": {
      "leaves": "illusion"
    },
    "limit": 80,
    "timeout": "judge"
  },
  "measures": {
    "length": {
      "value": "dx",
      "at": "end"
    },
    "stop": {
