        "enters": "illusion_end"
      }
    }
  },
  "verdict": {
    "success": "Illusion: {length} units, the dash ended on frame {stop}."
  },
  "checks": {
    "length 79": {
      "measure": "length",
      "within": [
        74,
        85
      ],
      "expect": "Full length, {79} units",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Let the dash run out: no B after the side-B. Any B pressed during the dash stops it."
    },
    "length 23": {
      "measure": "length",
      "within": [
        18,
        28
      ],
      "expect": "{23} units: B on frame {20} or {21}",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Press B on frame {20} or {21}, the first two frames of the dash, {19} frames after side-B. B during the startup is ignored; B on frame {22} goes {42} units."
    },
    "length 42": {
      "measure": "length",
      "within": [
        37,
        47
      ],
      "expect": "{42} units: B on frame {22}",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Press B on frame {22}, the third frame of the dash. B on frame {21} goes {23} units, and B on frame {23} goes {61}."
    },
    "length 61": {
      "measure": "length",
      "within": [
        55,
        66
      ],
      "expect": "{61} units: B on frame {23}",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Press B on frame {23}, the last frame of the dash. B on frame {22} goes {42} units; from frame {24} the dash is over and Illusion goes its full {79}."
    }
  },
