{
  "id": "fox-shorten",
  "name": "Shortened Illusion",
  "part": "tech",
  "characters": [
    "fox"
  ],
  "goal": "Stop Illusion at the length you choose.",
  "why": "A full Illusion always covers the same distance, so an edgeguarder can time a hit on its path or on where it ends. Stopping it with B gives three shorter lengths, and the one chosen decides where Fox ends up: short of the hit, at the ledge instead of over it, or at a chosen spot on the stage.",
  "tutorial": {
    "what": "In the air, Illusion dashes on frames {20} to {23}. B pressed during the dash stops it on that frame, before the frame's move: each frame of dash adds {18.72} units, and the drift after the dash adds {27.58}.",
    "expect": "Each Illusion is judged when it ends in a helpless fall: how far Fox travelled, and on which frame the dash ended. After misses, the coach shows your inputs frame by frame against the frame for the length asked.",
    "example": [
      {
        "stick": [
          1,
          0
        ],
        "frame": 1
      },
      {
        "press": "B",
        "frame": 1,
        "hold": 1
      },
      {
        "press": "B",
        "frame": 23,
        "hold": 1
      }
    ],
    "marks": {
      "1": "Frame 1: side-B. Startup",
      "20": "Frame {20}: the dash begins",
      "21": "Frame {21}: the first move, {18.72} units",
      "22": "Frame {22}: the second move",
      "23": "Frame {23}: B pressed. The dash stops before its third move",
      "24": "Frame {f}: drifting"
    },
    "lessons": [
      {
        "title": "Illusion's frames",
        "text": [
          "Side-B starts with {19} frames of startup, Fox holding his height in the air. On frame {20} the dash begins, and Fox moves {18.72} units on each of frames {21}, {22} and {23}.",
          "On frame {24} the dash is over: Fox drifts another {27.58} units while slowing down and starting to fall, and from frame {64} he falls helpless. In all, {83.74} units."
        ],
        "show": {
          "example": {
            "inputs": [
              {
                "stick": [
                  1,
                  0
                ],
                "frame": 1
              },
              {
                "press": "B",
                "frame": 1,
                "hold": 1
              }
            ],
            "marks": {
              "1": "Frame 1: side-B. Startup",
              "20": "Frame {20}: the dash begins",
              "21": "Frame {f}: dash, {18.72} units this frame",
              "24": "Frame {f}: drifting",
              "64": "Frame {64}: helpless"
            },
            "cues": [
              {
                "frames": [
                  1,
                  19
                ],
                "words": "Startup",
                "kind": "info"
              },
              {
                "frames": [
                  20,
                  23
                ],
                "words": "Dash",
                "kind": "info"
              },
              {
                "frames": [
                  24,
                  63
                ],
                "words": "Drift",
                "kind": "info"
              },
              {
                "frames": [
                  64,
                  80
                ],
                "words": "Helpless",
                "kind": "info"
              }
            ]
          }
        }
      },
      {
        "title": "Stopping the dash",
        "text": [
          "B pressed during the dash ends it on that frame, before the frame's move. B on frame {20} or {21}: no move, {27.58} units in all. Frame {22}: one move, {46.3} units. Frame {23}: two moves, {65.02} units. With no B, or B from frame {24}, the dash is already over: {83.74} units.",
          "B pressed during the startup is ignored, and holding B from the side-B does nothing: the stop takes a new press during the dash."
        ],
        "show": {
          "example": {
            "inputs": [
              {
                "stick": [
                  1,
                  0
                ],
                "frame": 1
              },
              {
                "press": "B",
                "frame": 1,
                "hold": 1
              }
            ],
            "marks": {
              "1": "Frame 1: side-B",
              "2": "Frame {f}: startup. B now is ignored",
              "20": "Frame {f}: B here stops Illusion at {28} units",
              "22": "Frame {22}: B here stops it at {46} units",
              "23": "Frame {23}: B here stops it at {65} units",
              "24": "Frame {f}: the dash is over. Full length, {84} units"
            },
            "cues": [
              {
                "frames": [
                  1,
                  19
                ],
                "words": "Startup: B is ignored",
                "kind": "late"
              },
              {
                "frames": [
                  20,
                  21
                ],
                "words": "B now: {28} units",
                "kind": "go"
              },
              {
                "frames": [
                  22,
                  22
                ],
                "words": "B now: {46} units",
                "kind": "go"
              },
              {
                "frames": [
                  23,
                  23
                ],
                "words": "B now: {65} units",
                "kind": "go"
              },
              {
                "frames": [
                  24,
                  63
                ],
                "words": "Full length: {84} units",
                "kind": "info"
              }
            ]
          }
        }
      }
    ]
  },
  "scenarios": [
    {
      "name": "Above the stage",
      "stage": "final-destination",
      "player": {
        "air": true,
        "x": -75,
        "y": 100
      },
      "opponent": "none",
      "camera": {
        "follow": "player",
        "distance": 260,
        "height": 10
      }
    }
  ],
  "attempt": {
    "start": {
      "enters": "illusion",
      "in_air": true
    },
    "judge": {
      "leaves": "illusion"
    },
    "limit": 80,
    "timeout": "judge"
  },
  "measures": {
    "length": {
      "value": "dx",
      "at": "end"
    },
    "stop": {
      "frame_of": {
        "enters": "illusion_end"
      }
    }
  },
  "verdict": {
    "success": "Illusion: {length} units, the dash ended on frame {stop}."
  },
  "checks": {
    "length 84": {
      "measure": "length",
      "within": [
        78,
        90
      ],
      "expect": "Full length, {84} units",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Let the dash run out: no B after the side-B. Any B pressed during the dash stops it."
    },
    "length 28": {
      "measure": "length",
      "within": [
        22,
        33
      ],
      "expect": "{28} units: B on frame {20} or {21}",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Press B on frame {20} or {21}, the first two frames of the dash, {19} frames after side-B. B during the startup is ignored; B on frame {22} goes {46} units."
    },
    "length 46": {
      "measure": "length",
      "within": [
        41,
        52
      ],
      "expect": "{46} units: B on frame {22}",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Press B on frame {22}, the third frame of the dash. B on frame {21} goes {28} units, and B on frame {23} goes {65}."
    },
    "length 65": {
      "measure": "length",
      "within": [
        60,
        71
      ],
      "expect": "{65} units: B on frame {23}",
      "words": "{measure} units; the dash ended on frame {stop}",
      "headline": "Wrong length",
      "fix": "Press B on frame {23}, the last frame of the dash. B on frame {22} goes {46} units; from frame {24} the dash is over and Illusion goes its full {84}."
    }
  },
