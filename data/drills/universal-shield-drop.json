        },
        {
          "stick": [
            0,
            -0.6
          ],
          "frame": 10,
          "hold": 3
        }
      ],
      "fails": "from shield"
    }
  ],
  "coach": {
    "rows": [
      {
        "label": "Shield",
        "state": "shield",
        "held": true,
        "perfect": []
      },
      {
        "label": "Down",
