  },
  "checks": {
    "with landing lag": {
      "measure": "landing_lag",
      "equals": true,
      "expect": "Land during an aerial",
      "words": "landed with no aerial landing lag",
      "headline": "No landing lag to cancel",
      "fix": "Land while the aerial is still going. An aerial that has ended, or that lands in its first or last few frames, has no landing lag."
    },
    "pressed": {
      "measure": "before",
      "at_least": 0,
      "expect": "L, R or Z pressed before landing",
      "words": "no press of L, R or Z up to the landing",
      "headline": "No press before landing",
      "fix": "Press L, R or Z as {char} comes down: on the landing frame or up to 6 frames before it. A press after the landing does nothing."
    },
    "in time": {
      "measure": "before",
      "at_most": 6,
      "expect": "L, R or Z within 6 frames before landing",
      "words": "pressed {frames} before landing",
      "headline": "Pressed too early",
      "fix": "Press later. The press counts for the frame it is made and the 6 after it; this one was {frames} before the landing."
    }
  },
  "parts": [
