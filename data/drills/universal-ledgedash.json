      "measure": "jump_after",
      "at_most": 1,
      "expect": "Double jump on the frame after the let-go",
      "words": "X or Y pressed {frames} after the let-go",
      "headline": "Late double jump",
      "fix": "Press X or Y on the frame after the stick lets go of the ledge. Each frame spent falling first is a frame of invincibility gone, and {char} has further to rise."
    },
    "onto the stage": {
      "measure": "onto",
      "equals": true,
      "expect": "An air dodge that lands on the stage",
      "words": "no air dodge landed on the stage",
      "headline": "No landing on the stage",
      "fix": "Air dodge down and toward the stage on frame {LD} or later, once {char} has risen above it. Below the stage, the air dodge hits its side and {char} falls helpless."
    },
    "invincible": {
      "measure": "inv",
      "at_least": 11,
      "expect": "Invincibility left after the landing lag",
      "words": "invincible for {frames} from the landing; the landing lag takes 10",
      "headline": "Too little invincibility left after the landing lag",
      "fix": "Let go of the ledge as soon as you can, double jump on the next frame, and air dodge on frame {LD}, the first frame {char} is above the stage. The invincibility counts down from the start of the hang: each frame of delay takes a frame from the end of the landing lag.",
      "strict": {
        "at_least": "max(11, 29-LD)",
        "expect": "Invincible for {max(11, 29-LD)} frames or more from the landing",
        "fix": "Let go of the ledge on the first frame you can, double jump on the next, and air dodge on frame {LD}. Then {char} lands with {max(1, 19-LD)} frames or more of invincibility left after the landing lag."
      }
    }
