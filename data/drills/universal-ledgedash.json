                  0.7,
                  -0.7
                ],
                "frame": "LD",
                "hold": 1
              },
              {
                "press": "R",
                "frame": "LD",
                "hold": 1
              }
            ],
            "frame": 0,
            "cue": {
              "words": "Hanging: invincible for 30 frames from the start of the hang",
              "kind": "info"
            },
            "inputs_for": {
              "mewtwo": [
                {
                  "stick": [
                    0,
                    -1
                  ],
                  "frame": 1,
                  "hold": 1
                },
                {
                  "press": "jump",
                  "frame": 2,
