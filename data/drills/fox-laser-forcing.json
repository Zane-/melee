{
 "id": "fox-laser-forcing",
 "name": "Lasers force the approach",
 "part": "neutral",
 "characters": [
  "fox"
 ],
 "goal": "Laser an opponent that stays away until it comes in, and punish the approach",
 "why": "Fox's lasers do not make an opponent flinch, but they add damage for nothing. An opponent that is being lasered has to come to Fox, on his terms: he knows the approach is coming and is ready for it.",
 "switch": "success",
 "reset": {
  "after": "quiet",
  "seconds": 1
 },
 "tutorial": {
  "what": "Short hop and press B twice: two lasers. Keep shooting until the opponent comes in. When it jumps at Fox, wavedash back, then dash in and grab it as it lands.",
  "expect": "The opponent does nothing until the lasers have hit it a few times; then it walks in and jumps at Fox. A try begins with its aerial and is judged when Fox grabs or hits it, when it hits Fox or his shield, or when it can act again.",
  "example": [
   {
    "press": "jump",
    "frame": 1,
    "hold": 1
   },
   {
    "press": "B",
    "frame": 4,
    "hold": 1
   },
   {
    "press": "B",
    "frame": 7,
    "hold": 1
   },
   {
