      "headline": "Wrong angle for this position",
      "fix": "From close under the ledge, aim nearly straight up: {70} to {90} degrees. Anything flatter runs into the underside of the stage."
    },
    "recovered": {
      "measure": "recovered",
      "equals": true,
      "expect": "The ledge or the stage reached",
      "words": "missed; the charge began at height {start_y}, the ledge's is 0",
      "headline": "Did not recover",
      "fix": "Up-B as soon as the drill starts: until the charge begins Fox falls, and the lower he is, the steeper the angle has to be."
    }
