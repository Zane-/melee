{
 "id": "fox-wavedash-back-punish",
 "name": "Wavedash back punish",
 "part": "neutral",
 "characters": [
  "fox"
 ],
 "goal": "Wavedash back out of a jump-in's range and grab it as it lands",
 "why": "A jump-in is aimed at where Fox stands. A wavedash back takes him out from under it in a few frames and leaves him facing it, free to act as it lands: the aerial's landing lag is the opening for a grab.",
 "switch": "success",
 "reset": {
  "after": "quiet",
  "seconds": 1
 },
 "tutorial": {
  "what": "When the opponent jumps at Fox: X or Y, then R with the stick back and a little down as he leaves the ground. As its aerial misses, dash in: X or Y and then Z, the jump-cancelled grab.",
  "expect": "A try begins when the opponent starts its aerial and is judged when Fox grabs or hits it, when it hits Fox or his shield, or when it can act again. It jumps in after a wait that changes from try to try.",
