{
 "id": "fox-kill-confirm",
 "name": "Kill confirms",
 "part": "punish",
 "characters": [
  "fox"
 ],
 "goal": "Take the stock from a grab: up throw into an up air that lands before the opponent can act",
 "why": "A grab at high damage is a stock if the up air after the up throw is a true combo: the opponent cannot act before it lands, and its second hit sends them off the top. Each opponent here is at the lowest damage where that kills on Final Destination.",
 "switch": "every",
 "reset": {
  "after": "quiet",
  "seconds": 1
 },
 "tutorial": {
  "what": "Grab with Z, press up to throw, jump after the opponent as soon as Fox can act, and press the C-stick up: both hits of the up air.",
  "expect": "A try begins with the up throw and is judged when the stock is gone, or when the opponent has got away: it double jumps on the first frame its hitstun is over, unless the up air has it.",
  "example": [
   {
    "press": "Z",
    "frame": 1,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 9,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 11,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 13,
    "hold": 1
   },
   {
    "stick": [
     0,
     1
    ],
    "frame": 15,
    "hold": 1
   },
   {
    "stick": [
     "SIDE",
     0
    ],
    "frame": "FREE",
    "hold": 40,
    "from": "start"
   },
   {
    "press": "jump",
    "frame": "JF",
    "hold": 4,
    "from": "start"
   },
   {
    "press": "jump",
    "frame": "DJ",
    "hold": 2,
    "from": "start"
   },
   {
    "cstick": [
     0,
     1
    ],
    "frame": "UA",
    "hold": 2,
    "from": "start"
   }
  ],
  "marks": {
   "1": "Frame 1: the up throw",
   "FREE": "Frame {FREE}: Fox can act. Toward where it flies",
   "JF": "Frame {JF}: X or Y, held: a full hop",
   "UA": "Frame {UA}: the C-stick up. The up air"
  },
  "lessons": [
   {
    "title": "The confirm",
    "text": [
     "At {PCT}%, {opp} is in hitstun from the up throw until frame {OVER}, and Fox can act on frame {FREE}. An up air that lands in between cannot be escaped.",
     "The up air hits twice. The second hit is the strong one: from this height it takes the stock."
    ],
