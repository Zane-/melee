  "verdict": {
    "success": "SHFFL shine. Landing lag {lag_frames}, shine on frame {shine_frame} (the first possible: {free_frame})."
  },
  "checks": {
    "short hop": {
      "measure": "kind",
      "equals": "short",
      "expect": "A short hop",
      "words": "a {measure} hop",
      "headline": "Full hop",
      "fix": "Tap X or Y: release it within {J-1} frames."
    },
    "aerial": {
      "measure": "aerial",
      "equals": true,
      "expect": "An aerial",
      "words": "no aerial before landing",
      "headline": "No aerial",
      "fix": "Press A, or tilt the C-stick, once {char} is off the ground, from frame {J+1}. A pressed before {char} leaves the ground is not an aerial."
    },
    "fast fall": {
      "measure": "fast_fell",
      "equals": true,
      "expect": "A fast fall",
      "words": "landed without a fast fall",
      "headline": "No fast fall",
      "fix": "Tap the control stick down once {char} starts to fall, from frame {SA} of the short hop. The aerial does not stop a fast fall."
    },
    "with landing lag": {
      "measure": "landing_lag",
      "equals": true,
      "expect": "Land during the aerial",
      "words": "landed with no aerial landing lag",
      "headline": "No landing lag",
      "fix": "Land while the aerial is still out: press A or the C-stick once {char} is off the ground, from frame {J+1}. An aerial that has ended, or that has only just begun, lands with no landing lag, and the shine is timed from the end of that lag."
    },
    "l-cancel": {
      "measure": "lag",
      "at_most": 11,
      "expect": "Landing lag halved by an L-cancel",
      "words": "landing lag {frames}",
      "headline": "No L-cancel",
      "fix": "Press L, R or Z on the frame {char} lands or on one of the {6} frames before it. Earlier, or after landing, the full landing lag applies."
    },
    "shined": {
      "measure": "shined",
      "equals": true,
      "expect": "A shine after landing",
      "words": "no shine after the landing lag",
      "headline": "No shine",
      "fix": "Press down-B on the first frame after the landing lag. Down-B pressed during the lag is ignored, and holding B does not carry it over: press it again."
    },
    "shine in time": {
      "measure": "shine_gap",
      "at_most": 1,
      "expect": "Shine within {1} frame of the landing lag's end",
      "words": "late by {frames}: the shine came on frame {shine_frame}, the first frame it could was {free_frame}",
      "headline": "Late shine",
      "fix": "Press down-B on the first frame after the landing lag: {7} frames after landing for an L-cancelled neutral air, {9} for down air. Pressed during the lag it is ignored.",
      "strict": {
        "equals": 0,
        "expect": "Shine on the first frame after the landing lag",
        "fix": "Press down-B on the first frame after the landing lag, not a frame later: {7} frames after landing for an L-cancelled neutral air, {9} for down air."
      }
    }
  },
