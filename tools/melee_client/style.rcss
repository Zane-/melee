/* The client's look, for RmlUi (which has no built-in styles: every element
   kind used is given its display here). Written for a 1280 by 720 window in
   dp; src/host/ui.cpp scales dp with the window's height.

   One slant (12 degrees) for every panel; text inside a slanted panel sits
   in an element slanted back (.in, .un). No CSS grid and no clip-path in
   RmlUi: layouts are flex rows and columns, and a focus ring is an element
   of its own (.ring) laid over its panel. */

body {
    display: block;
    width: 1280dp;
    height: 720dp;
    font-family: "Barlow";
    font-weight: 500;
    font-size: 16dp;
    color: #12161C;
}
body.paper { background-color: #E9EDF2; }
div { display: block; }
span { display: inline; }

.disp { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; text-transform: uppercase; }
.mono { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 500; }
.row { display: flex; flex-direction: row; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }
.un { transform: skewX(12deg); }

/* ---- header, ruler, footer -------------------------------------------- */

.header { position: absolute; left: 0dp; top: 0dp; width: 1280dp; height: 84dp; display: flex; flex-direction: row; }
.plate { margin-left: -14dp; padding: 0dp 40dp 0dp 62dp; background-color: #12161C; color: #F3F6FA; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; }
.title { transform: skewX(12deg); font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 46dp; text-transform: uppercase; letter-spacing: 1dp; }
.title .dim { color: #A9B4C2; }
.stripe { width: 14dp; margin-left: 8dp; transform: skewX(-12deg); }
.who { display: flex; flex-direction: row; align-items: center; padding-right: 48dp; font-weight: 600; font-size: 15dp; }
.who .port { font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #4A5361; margin-right: 10dp; }
.who .nick { background-color: #12161C; color: #F3F6FA; padding: 5dp 12dp; border-radius: 4dp; font-family: "IBM Plex Mono"; font-style: normal; font-size: 14dp; margin-right: 10dp; }
.who .layout { color: #4A5361; }
.tag { padding: 4dp 18dp; border: 1dp #12161C; transform: skewX(-12deg); margin-right: 12dp; }
.tag .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 24dp; text-transform: uppercase; letter-spacing: 1dp; }
.hvs { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 13dp; color: #4A5361; margin-right: 12dp; }

.ruler { position: absolute; left: 0dp; top: 84dp; width: 1280dp; height: 12dp; display: flex; flex-direction: row; }
.tick { flex: 1; height: 6dp; margin-top: 6dp; border-left: 1dp #8A94A3; }
.tick.ten { height: 12dp; margin-top: 0dp; border-left: 2dp #12161C; }

.footer { position: absolute; left: 0dp; top: 640dp; width: 1280dp; height: 80dp; box-sizing: border-box; padding: 0dp 48dp; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: row; align-items: center; }
.footer .tab { width: 14dp; height: 40dp; margin-right: 16dp; transform: skewX(-12deg); background-color: #F3F6FA; }
.footer .desc { font-size: 20dp; }
.hint { display: flex; flex-direction: row; align-items: center; margin-left: 22dp; font-size: 16dp; font-weight: 600; }
.key { width: 24dp; height: 24dp; border: 2dp #F3F6FA; border-radius: 14dp; margin-right: 8dp; text-align: center; line-height: 24dp; font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 14dp; }
.key.dark { border-color: #12161C; }
.key.wide { width: auto; padding: 0dp 8dp; border-radius: 4dp; }
/* The GameCube controller's buttons as they look on it (screens.key): A
   green and large, B red, X and Y grey kidneys, Z purple, the triggers
   grey, START a small grey button, the D-pad a cross with the arm meant
   lit. The greys have an edge, to show on the light pause box too. */
.glyphs { display: flex; flex-direction: row; align-items: center; margin-right: 2dp; }
.gc { display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 8dp; font-family: "Barlow"; font-style: normal; font-weight: 700; font-size: 13dp; line-height: 1em; }
.gc.a { width: 26dp; height: 26dp; border-radius: 13dp; background-color: #1EA85E; color: #FFFFFF; font-size: 15dp; }
.gc.b { width: 22dp; height: 22dp; border-radius: 11dp; background-color: #E2382F; color: #FFFFFF; }
.gc.x { width: 15dp; height: 26dp; border-radius: 8dp; background-color: #D3D8DF; color: #12161C; border: 1dp #5C6573; }
.gc.y { width: 26dp; height: 15dp; border-radius: 8dp; background-color: #D3D8DF; color: #12161C; border: 1dp #5C6573; }
.gc.z { width: 30dp; height: 15dp; border-radius: 4dp; background-color: #6E5BE0; color: #FFFFFF; font-size: 11dp; }
.gc.lt, .gc.rt { width: 30dp; height: 18dp; border-radius: 9dp 9dp 3dp 3dp; background-color: #C2C8D0; color: #12161C; border: 1dp #5C6573; }
.gc.st { height: 15dp; padding: 0dp 6dp; border-radius: 8dp; background-color: #C2C8D0; color: #12161C; border: 1dp #5C6573; font-size: 9dp; letter-spacing: 0.6dp; }
.gc.c { width: 22dp; height: 22dp; border-radius: 11dp; background-color: #F5C518; color: #12161C; }
.dpad { position: relative; width: 24dp; height: 24dp; margin-right: 8dp; }
.dpad .v { position: absolute; left: 8dp; top: 0dp; width: 8dp; height: 24dp; border-radius: 2dp; background-color: #8A94A3; }
.dpad .h { position: absolute; left: 0dp; top: 8dp; width: 24dp; height: 8dp; border-radius: 2dp; background-color: #8A94A3; }
.dpad .arm { position: absolute; background-color: #F5BE1B; }
.dpad .up { left: 8dp; top: 0dp; width: 8dp; height: 9dp; }
.dpad .down { left: 8dp; top: 15dp; width: 8dp; height: 9dp; }
.dpad .left { left: 0dp; top: 8dp; width: 9dp; height: 8dp; }
.dpad .right { left: 15dp; top: 8dp; width: 9dp; height: 8dp; }
.hint .glyphs { margin-right: 4dp; }
/* a column of the sidebar's buttons, so that what they do lines up */
.hintrow .glyphs { width: 44dp; margin-right: 6dp; justify-content: center; }
.hintrow .glyphs .gcimg, .hintrow .glyphs .gc, .hintrow .glyphs .dpad { margin-right: 2dp; }
/* SmashWiki's icons of the buttons (buttons.py), when the client has them,
   cut to the button: each a height, its width its own shape's. As on the
   controller, A is the largest and B smaller; START carries its label. */
.gcimg { height: 24dp; margin-right: 8dp; }
.gcimg.a { height: 27dp; }
.gcimg.b { height: 21dp; }
.gcimg.x, .gcimg.y, .gcimg.c { height: 22dp; }
.gcimg.z { height: 14dp; }
.gcimg.l, .gcimg.r { height: 18dp; }
/* (.r is also the drill list's row: none of it on the R button) */
.gcimg.r { display: inline-block; padding: 0dp; margin-bottom: 0dp; background-color: transparent; box-sizing: content-box; }
.gcimg.start { height: 27dp; }

/* ---- panels ----------------------------------------------------------- */

.tile { position: relative; display: flex; flex-direction: column; }
/* The ring is always there and only its colour changes. Shown and hidden
   instead (display), a ring that appears later is drawn without the slant
   of the panels it sits in: a square round a slanted panel. */
.ring { position: absolute; left: -10dp; top: -10dp; right: -10dp; bottom: -10dp; border: 4dp #00000000; }
.focus .ring { border-color: #12161C; }
.in { position: relative; flex: 1; transform: skewX(12deg); display: flex; flex-direction: column; justify-content: space-between; }
/* A panel's large faded drawing (marks.py), upright in the slanted panel
   and cut by its edges; the panel's content and bands are drawn over it */
.mkclip { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow: hidden; clip: always; }
.mk { position: absolute; transform: skewX(12deg); }
#versus .mk { left: 222dp; top: -34dp; width: 430dp; height: 430dp; }
#train .mk { left: 276dp; top: -40dp; width: 330dp; height: 330dp; }
#settings .mk { left: 352dp; top: -40dp; width: 210dp; height: 210dp; }
#vlocal .mk { left: 196dp; top: 24dp; width: 470dp; height: 362dp; }
#vonline .mk { left: 232dp; top: -20dp; width: 420dp; height: 420dp; }
#scontrols .mk { left: 206dp; top: 30dp; width: 420dp; height: 323dp; }
#sonline .mk { left: 296dp; top: -48dp; width: 300dp; height: 300dp; }
#ssound .mk, #sdisplay .mk { left: 86dp; top: -10dp; width: 260dp; height: 260dp; }
.slab .mk { left: 90dp; top: -18dp; width: 250dp; height: 250dp; }
#lab .mk { left: 116dp; top: -26dp; width: 190dp; height: 190dp; }
.idx { font-family: "IBM Plex Mono"; font-style: normal; font-size: 14dp; }
.soon { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 12dp; padding: 2dp 7dp; border: 1dp #12161C; }
.big { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; text-transform: uppercase; line-height: 0.9em; }
.sub { font-weight: 500; margin-top: 6dp; }

.ink { background-color: #12161C; color: #F3F6FA; }
.tech { background-color: #1F49C9; color: #FFFFFF; }
.punish { background-color: #F0643C; color: #12161C; }
.defense { background-color: #22B8A0; color: #12161C; }
.neutral { background-color: #F5BE1B; color: #12161C; }
.lab { background-color: #5B3FD6; color: #FFFFFF; }
.red { background-color: #D0283E; color: #FFFFFF; }
.slate { background-color: #2B3340; color: #F3F6FA; }
.white { background-color: #FFFFFF; color: #12161C; }
.lab .soon, .slate .soon, .ink .soon { border-color: #F3F6FA; }

/* ---- main menu -------------------------------------------------------- */

.mosaic { position: absolute; left: 76dp; top: 120dp; width: 1128dp; height: 496dp; display: flex; flex-direction: row; transform: skewX(-12deg); }
.mosaic .gap { width: 16dp; height: 16dp; }
#versus { width: 556dp; }
#versus .in { padding: 22dp 64dp 18dp 64dp; }
#versus .big { font-size: 148dp; }
#versus .sub { font-size: 20dp; margin-top: 10dp; }
#versus .last { color: #FFE3E7; }
.band.vl { background-color: #F3F6FA; color: #12161C; }
.band.vo { background-color: #12161C; color: #F3F6FA; }
.last { display: flex; flex-direction: row; align-items: center; margin-top: 12dp; font-size: 15dp; color: #D5DCE5; }
.last .mark { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 13dp; padding: 3dp 9dp; margin-right: 10dp; color: #12161C; }
.bands { position: relative; height: 72dp; display: flex; flex-direction: row; }
.band { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.band .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 25dp; text-transform: uppercase; letter-spacing: 1dp; }
.right { width: 556dp; display: flex; flex-direction: column; }
#train { height: 350dp; }
#train .in { padding: 18dp 44dp 14dp 44dp; }
#train .big { font-size: 96dp; }
#train .sub { font-size: 18dp; margin-top: 6dp; }
#train .bands { height: 54dp; }
#train .band .un { font-size: 21dp; }
#settings { height: 130dp; border: 1dp #C9D1DB; }
#settings .in { padding: 12dp 40dp; }
#settings .big { font-size: 52dp; }
#settings .sub { font-size: 15dp; margin-top: 2dp; color: #4A5361; }
/* (Settings' own screen lays out its lower panels in this) */
.lower { height: 276dp; display: flex; flex-direction: row; }

/* ---- character select -------------------------------------------------- */

.roster { position: absolute; left: 54dp; top: 120dp; width: 770dp; height: 496dp; display: flex; flex-direction: column; }
.rrow { display: flex; flex-direction: row; flex-wrap: nowrap; }
/* A panel: the game's portrait over its series emblem, cut to the slant
   (.pic clips; .pin, slanted back, holds the pictures upright), the name
   on an ink strip, the part colours above it if it has a course. */
.char { position: relative; width: 98dp; height: 114dp; margin: 0dp 10dp 10dp 0dp; border: 1dp #12161C; transform: skewX(-12deg); }
.char .ring { left: -8dp; top: -8dp; right: -8dp; bottom: -8dp; border-width: 5dp; }
.char .pic { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow: hidden; clip: always; }
.char .pin { position: absolute; left: -14dp; right: -14dp; top: 0dp; bottom: 0dp; transform: skewX(12deg); }
.char .wm { position: absolute; left: 15dp; top: 8dp; width: 96dp; height: 77dp; }
.char .face { position: absolute; left: 2.3dp; width: 120.4dp; height: 165.1dp; }
.char .course { position: absolute; left: 0dp; right: 0dp; bottom: 22dp; height: 6dp; display: flex; flex-direction: row; border-top: 1dp #12161C; }
.char .course div { flex: 1; }
.char .strip { position: absolute; left: 0dp; right: 0dp; bottom: 0dp; height: 22dp; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.char .strip .un { font-family: "Barlow Condensed"; font-weight: 700; font-size: 14dp; text-transform: uppercase; letter-spacing: 0.5dp; white-space: nowrap; }
img { display: inline-block; }

.card { position: absolute; left: 844dp; top: 120dp; width: 388dp; height: 496dp; background-color: #12161C; color: #F3F6FA; overflow: hidden; }
.card .top { position: absolute; left: 0dp; top: 0dp; width: 388dp; height: 104dp; }
.card .slant { position: absolute; left: 0dp; top: 70dp; width: 388dp; height: 60dp; transform: skewY(-5deg); }
.card .head { position: absolute; left: 26dp; top: 16dp; width: 340dp; }
.tags { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 13dp; }
.who2 { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; text-transform: uppercase; line-height: 0.95em; white-space: nowrap; }
.card .body { position: absolute; left: 26dp; top: 150dp; width: 336dp; height: 326dp; display: flex; flex-direction: column; }
.stats { display: flex; flex-direction: row; }
.stat { flex: 1; }
.stat .n { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 40dp; line-height: 1em; }
.stat .l { font-size: 13dp; color: #A9B4C2; }
.about { margin-top: 12dp; padding-top: 12dp; border-top: 1dp #4A5361; font-size: 15dp; line-height: 1.35em; color: #D5DCE5; }
.parts { margin-top: 10dp; display: flex; flex-direction: row; flex-wrap: wrap; font-size: 16dp; font-weight: 600; }
.part { width: 168dp; height: 26dp; display: flex; flex-direction: row; align-items: center; }
.part .sq { width: 14dp; height: 14dp; margin-right: 10dp; transform: skewX(-12deg); }
.part .cnt { font-family: "IBM Plex Mono"; font-style: normal; font-size: 14dp; color: #A9B4C2; margin-left: 8dp; }
.as { display: flex; flex-direction: row; align-items: center; font-size: 15dp; margin-bottom: 12dp; }
.as .l { color: #A9B4C2; }
.go { height: 54dp; background-color: #F3F6FA; color: #12161C; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.go .un { display: flex; flex-direction: row; align-items: center; font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 27dp; text-transform: uppercase; letter-spacing: 1dp; }

/* The card with the game's art: the colour, the emblem (behind the name:
   the portraits fill their pictures and hid it there), and the portrait,
   which stands out over the card's top edge. The pictures carry a 2dp
   border (art.PAD), so their boxes are that much larger, scaled. An ink
   wedge, slanted as the other cards' heads (5 degrees), cuts the
   portrait's bottom edge. No clip-path in RmlUi: the wedge is clipped by a
   box that is not slanted. RmlUi clips only what it counts as
   overflowing, which leaves out positioned children: `clip: always` makes
   a box clip them. */
.card.art { overflow: visible; }
.aclip { position: absolute; left: 0dp; top: 0dp; width: 388dp; height: 214dp; overflow: hidden; clip: always; }
.acolor { position: absolute; left: 0dp; top: 0dp; width: 388dp; height: 214dp; }
.awm { position: absolute; left: 192dp; top: 58dp; width: 180dp; height: 144dp; }
/* The portrait inside the card (the owner, 2026-11-14: "scale down the
   character and the wall so it fits within the card, I don't want a line
   bleeding out of the container"): its frame's top and left edges (past
   the picture's 2-pixel border) on the card's, where a flat cut in the
   art is the card's own edge; its bottom behind the wall. */
.abig { position: absolute; left: -2.4dp; top: -2.4dp; width: 166.3dp; height: 228dp; }
.wclip { position: absolute; left: 0dp; top: 170dp; width: 388dp; height: 326dp; overflow: hidden; clip: always; }
.wedge { position: absolute; left: 0dp; top: 27dp; width: 388dp; height: 340dp; background-color: #12161C; transform: skewY(-5deg); }
.aname { position: absolute; left: 184dp; top: 18dp; width: 192dp; }
/* The portrait behind a wall: the ink below is a wall in front of the
   character, its top face lit along its edge, and an upright post between
   the character and the name hides the portrait's cut right side (it is
   upright, as the cut is). Each casts a soft shadow on the character.
   All of it inside the card. */
.ashade { position: absolute; left: 0dp; top: 0dp; width: 388dp; height: 214dp; overflow: hidden; clip: always; }
.wshadow { position: absolute; left: -16dp; top: 119dp; width: 420dp; height: 64dp; transform: rotate(-5deg); decorator: vertical-gradient(#12161C00 #12161C80); }
.postsh { position: absolute; left: 132dp; top: 0dp; width: 24dp; height: 214dp; decorator: horizontal-gradient(#12161C00 #12161C66); }
.wfclip { position: absolute; left: 0dp; top: 150dp; width: 388dp; height: 80dp; overflow: hidden; clip: always; }
.wface { position: absolute; left: 0dp; top: 33dp; width: 388dp; height: 16dp; background-color: #2B3340; transform: skewY(-5deg); }
.wlip { position: absolute; left: 0dp; top: 33dp; width: 388dp; height: 2dp; background-color: #6B7686; transform: skewY(-5deg); }
.post { position: absolute; left: 156dp; top: 0dp; width: 12dp; height: 200dp; background-color: #12161C; }
.plip { position: absolute; left: 156dp; top: 0dp; width: 2dp; height: 200dp; background-color: #6B7686; }
.aname .tags { font-size: 11dp; line-height: 1.35em; }
.aname .who2 { white-space: normal; line-height: 0.9em; margin-top: 6dp; }
.abody { position: absolute; left: 26dp; top: 222dp; width: 336dp; height: 254dp; display: flex; flex-direction: column; }
.abody .stat .n { font-size: 34dp; }
.abody .about { margin-top: 8dp; padding-top: 8dp; }
.abody .parts { margin-top: 4dp; }
.abody .part { height: 22dp; }
.cos { display: flex; flex-direction: row; align-items: center; height: 46dp; margin-top: 10dp; }
.cos .key, .cos .gc, .cos .gcimg { margin-right: 12dp; }
.cchip { position: relative; width: 36dp; height: 44dp; margin-right: 8dp; box-sizing: border-box; border: 2dp #4A5361; transform: skewX(-12deg); overflow: hidden; clip: always; }
.cchip.on { border-color: #F3F6FA; }
.cpin { position: absolute; left: -6dp; right: -6dp; top: 0dp; bottom: 0dp; transform: skewX(12deg); }
.cimg { position: absolute; left: -3.8dp; width: 56dp; height: 76.8dp; }
.form { height: 34dp; padding: 0dp 12dp; border: 2dp #F3F6FA; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; }
.form .un { display: flex; flex-direction: row; align-items: center; font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 20dp; text-transform: uppercase; letter-spacing: 0.5dp; }
.card .body.low { top: 222dp; height: 254dp; }
.body.low .fact { padding: 3dp 0dp; }
.body.low .big2 { font-size: 22dp; }
.body.low .pick { margin: 0dp 0dp 4dp 0dp; }

/* ---- in a match: the column beside the game ---------------------------- */

.rail { position: absolute; left: 960dp; top: 0dp; width: 320dp; height: 720dp; background-color: #12161C; color: #F3F6FA; overflow: hidden; }
.rail .top { position: absolute; left: 0dp; top: 0dp; width: 320dp; height: 92dp; }
.rail .slant { position: absolute; left: 0dp; top: 62dp; width: 320dp; height: 52dp; transform: skewY(-5deg); }
.rail .head { position: absolute; left: 24dp; top: 18dp; width: 280dp; }
.rail .body { position: absolute; left: 24dp; top: 140dp; width: 272dp; height: 560dp; display: flex; flex-direction: column; }
.rail .line { font-size: 14dp; line-height: 1.3em; color: #D5DCE5; }
.rail .hints { display: flex; flex-direction: column; font-size: 14dp; font-weight: 600; }
.rail .hintrow { display: flex; flex-direction: row; align-items: center; margin-top: 8dp; }
.rail .key.wide { margin-right: 10dp; }
/* a drill's three controls, side by side at the sidebar's foot */
.rail .hbar { display: flex; flex-direction: row; margin-top: 12dp; padding-top: 10dp; border-top: 1dp #2B3340; }
.rail .hcell { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; font-size: 12dp; font-weight: 600; color: #D5DCE5; }
.rail .hcell .glyphs { height: 28dp; margin: 0dp 0dp 4dp 0dp; justify-content: center; }
.rail .hcell .gcimg, .rail .hcell .dpad { margin: 0dp; }
.rail .hcell .hl { line-height: 1.2em; }

/* ---- the course hub ---------------------------------------------------- */

.hub { position: absolute; left: 76dp; top: 120dp; width: 1128dp; height: 496dp; display: flex; flex-direction: column; transform: skewX(-12deg); }
.hub .gap { width: 16dp; height: 16dp; }
.slabs { height: 336dp; display: flex; flex-direction: row; }
.slab { flex: 1; }
.slab .in { padding: 16dp 38dp; }
.slab .big { font-size: 60dp; }
.slab .q { font-size: 19dp; font-weight: 700; margin-top: 8dp; line-height: 1.15em; }
.slab .d { font-size: 15dp; margin-top: 6dp; line-height: 1.3em; }
.first { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 12dp; padding: 2dp 7dp; background-color: #FFFFFF; color: #12161C; }
.sqs { display: flex; flex-direction: row; flex-wrap: wrap; margin-bottom: 4dp; }
.sq { width: 9dp; height: 12dp; margin: 0dp 3dp 3dp 1dp; border: 1dp #12161C; transform: skewX(-12deg); }
.sq.on { background-color: #12161C; }
.tech .sq { border-color: #FFFFFF; }
.tech .sq.on { background-color: #FFFFFF; }
.cnt2 { font-size: 14dp; font-weight: 600; line-height: 1.3em; }
.hubrow { height: 144dp; display: flex; flex-direction: row; }
#lab { width: 270dp; }
#lab .in { padding: 14dp 30dp; }
#lab .big { font-size: 54dp; }
#lab .sub { font-size: 15dp; margin-top: 2dp; }
.lbl { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 500; font-size: 13dp; color: #A9B4C2; }
.lab .lbl { color: #E2DCFA; }
.leftoff { padding: 14dp 34dp; flex-direction: row; align-items: center; }
.leftoff .big { font-size: 44dp; margin-top: 4dp; }
.leftoff .row { align-items: center; margin-top: 6dp; font-size: 15dp; color: #D5DCE5; }
.leftoff .sum { margin-top: 6dp; font-size: 17dp; line-height: 1.35em; color: #F3F6FA; }
.sq2 { width: 12dp; height: 12dp; margin-right: 8dp; border: 1dp #F3F6FA; transform: skewX(-12deg); }
.go.small { width: 200dp; }

/* ---- a part's drills ----------------------------------------------------- */

.tabs { position: absolute; left: 54dp; top: 120dp; width: 780dp; height: 40dp; display: flex; flex-direction: row; align-items: center; }
.tabs .key, .tabs .gc, .tabs .gcimg { margin: 0dp 12dp 0dp 6dp; }
.ptab { height: 40dp; padding: 0dp 22dp; margin-right: 10dp; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; border: 3dp #00000000; }
.ptab.on { border-color: #12161C; }
.ptab .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 23dp; text-transform: uppercase; letter-spacing: 1dp; }
.listhead { position: absolute; left: 48dp; top: 172dp; width: 780dp; height: 28dp; box-sizing: border-box; padding: 0dp 14dp; display: flex; flex-direction: row; align-items: center; font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #4A5361; }
.rows { position: absolute; left: 48dp; top: 200dp; width: 780dp; height: 416dp; }
.r { height: 48dp; margin-bottom: 4dp; box-sizing: border-box; padding: 0dp 14dp; background-color: #FFFFFF; display: flex; flex-direction: row; align-items: center; }
.r.on { background-color: #12161C; color: #F3F6FA; }
.c-n { width: 56dp; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; }
.cap { width: 8dp; height: 30dp; margin-right: 10dp; transform: skewX(-12deg); }
.num { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 15dp; }
.c-name { flex: 1; overflow: hidden; }
.nm { font-size: 17dp; font-weight: 700; line-height: 1.15em; white-space: nowrap; }
.gl { font-size: 13dp; line-height: 1.2em; color: #4A5361; white-space: nowrap; }
.r.on .gl { color: #D5DCE5; }
.c-t { width: 74dp; box-sizing: border-box; text-align: right; font-family: "IBM Plex Mono"; font-style: normal; font-size: 15dp; }
.c-b { width: 56dp; box-sizing: border-box; text-align: right; font-family: "IBM Plex Mono"; font-style: normal; font-size: 15dp; }
.c-d { width: 104dp; box-sizing: border-box; padding-left: 28dp; display: flex; flex-direction: row; align-items: center; font-size: 14dp; font-weight: 700; }
.box { width: 16dp; height: 16dp; margin-right: 8dp; border: 2dp #12161C; transform: skewX(-12deg); }
.box.on { background-color: #12161C; }
.r.on .box { border-color: #F3F6FA; }
.r.on .box.on { background-color: #F3F6FA; }

.detail .top { height: 100dp; }
.detail .slant { top: 66dp; }
.dname { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; text-transform: uppercase; line-height: 1em; margin-top: 2dp; }
.detail .body { top: 146dp; height: 330dp; }
.goal { font-size: 16dp; line-height: 1.35em; color: #D5DCE5; margin-bottom: 8dp; }
.fact { padding: 6dp 0dp; border-top: 1dp #4A5361; }
.fl { font-size: 13dp; color: #A9B4C2; }
.fv { font-size: 15dp; font-weight: 600; line-height: 1.3em; }
.donebtn { height: 40dp; box-sizing: border-box; padding: 0dp 12dp; margin-bottom: 12dp; border: 2dp #F3F6FA; display: flex; flex-direction: row; align-items: center; font-size: 16dp; font-weight: 700; }
.donebtn .box { border-color: #F3F6FA; }
.donebtn.on { background-color: #F3F6FA; color: #12161C; }
.donebtn.on .box { border-color: #12161C; background-color: #12161C; }
.donebtn .key, .donebtn .gc, .donebtn .gcimg { margin-right: 0dp; }
.go.off { background-color: #2B3340; color: #A9B4C2; }
.go.off .key { border-color: #A9B4C2; }

/* ---- a drill running ------------------------------------------------------ */

.rail .body { top: 128dp; height: 584dp; }
.try { margin-top: 8dp; padding: 8dp 14dp; background-color: #1D2430; }
.verdict { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 44dp; line-height: 0.95em; text-transform: uppercase; }
.chk { display: flex; flex-direction: row; align-items: center; padding: 3dp 0dp; border-top: 1dp #4A5361; font-size: 15dp; font-weight: 600; }
.chk .box { width: 12dp; height: 12dp; border-color: #F3F6FA; }
.chk .box.on { background-color: #F3F6FA; }
.yn { font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #A9B4C2; }
.lastrow { margin-top: 8dp; }
.sqs3 { flex: 0 0 22dp; margin-top: 6dp; display: flex; flex-direction: row; }
.sq3 { flex: 1; margin: 0dp 3dp; border: 2dp #F3F6FA; transform: skewX(-12deg); }
.sq3.on { background-color: #F3F6FA; }
.sq3.none { border-color: #4A5361; }
.stats.two { margin-top: 8dp; padding-top: 6dp; border-top: 1dp #4A5361; }
.stats.two .n { font-size: 30dp; }
/* the verdict, over the top of the game's picture: small enough to leave the fight in view */
.bannerwrap { position: absolute; left: 0dp; top: 14dp; width: 960dp; height: 34dp; display: flex; flex-direction: row; justify-content: center; }
.banner { display: none; height: 30dp; border: 2dp #F3F6FA; transform: skewX(-12deg); flex-direction: row; }
.banner.on { display: flex; }
.chip { padding: 0dp 12dp; background-color: #F3F6FA; color: #12161C; display: flex; flex-direction: row; align-items: center; }
/* the verdict's colour: the palette's green (Defense) and red (Punish) */
.chip.good { background-color: #22B8A0; color: #FFFFFF; }
.chip.bad { background-color: #F0643C; color: #FFFFFF; }
.banner.good { border-color: #22B8A0; }
.banner.bad { border-color: #F0643C; }
.verdict.good { color: #22B8A0; }
.verdict.bad { color: #F0643C; }
.chip .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 22dp; text-transform: uppercase; letter-spacing: 1dp; }
.msg { padding: 0dp 14dp; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: row; align-items: center; }
.msg .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 16dp; text-transform: uppercase; letter-spacing: 1dp; }
.why { font-size: 14dp; line-height: 1.25em; color: #D5DCE5; margin: 0dp 0dp 5dp 0dp; }
.tlrow { height: 16dp; margin-top: 3dp; display: flex; flex-direction: row; align-items: center; }
.tll { width: 52dp; font-size: 13dp; font-weight: 600; white-space: nowrap; }
.tlc { flex: 1; height: 15dp; margin: 0dp 1dp; box-sizing: border-box; }
.tln { font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; color: #A9B4C2; text-align: center; border-bottom: 1dp #A9B4C2; }
.tlc.win { background-color: #2A3A66; }
.tlc.perf { border: 2dp #F3F6FA; }
.tlc.you { background-color: #F3F6FA; }
.tlleg { margin-top: 6dp; display: flex; flex-direction: row; align-items: center; font-size: 12dp; color: #D5DCE5; }
.tlleg .tlc { flex: none; width: 12dp; height: 12dp; margin: 0dp 5dp 0dp 0dp; }
.tlleg div { margin-right: 10dp; }
.tlnote { margin-top: 3dp; font-size: 13dp; color: #A9B4C2; }

/* ---- versus and lab ------------------------------------------------------- */

.big2 { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 26dp; line-height: 1.05em; text-transform: uppercase; }
.pick { display: flex; flex-direction: row; align-items: center; margin: 2dp 0dp 8dp 0dp; font-size: 14dp; font-weight: 600; color: #D5DCE5; }
.pick .key, .pick .gc, .pick .gcimg { margin-right: 8dp; }
.botstate { margin-top: 12dp; }

/* ---- over the game: the pause menu; the column hidden ---- */

.rail.hidden { display: none; }
.bannerwrap.mid, .pause.mid, .rays.mid { left: 160dp; }
.rays { position: absolute; left: 0dp; top: 0dp; width: 960dp; height: 720dp; }
.ray { position: absolute; top: 0dp; width: 18dp; decorator: vertical-gradient(#9CF0FF00 #9CF0FFB4); }
.rayfoot { position: absolute; width: 44dp; height: 10dp; border-radius: 5dp; background-color: #C8F8FFC8; }
/* the pause menu: a slanted sheet down the left of the picture, tabs (L
   and R), a row an icon, the drills before and after (the canvas's
   "Paused: icons and the input display") */
.pause { display: none; position: absolute; left: 0dp; top: 0dp; width: 960dp; height: 720dp; overflow: hidden; clip: always; color: #F3F6FA; }
.pause.on { display: block; }
.pdim { position: absolute; left: 0dp; top: 0dp; width: 960dp; height: 720dp; background-color: #05070A8C; }
.pshade { position: absolute; left: -40dp; top: 0dp; width: 634dp; height: 720dp; background-color: #1F49C9; transform-origin: left top; transform: skewX(-10deg); }
.psheet { position: absolute; left: -40dp; top: 0dp; width: 620dp; height: 720dp; background-color: #12161C; transform-origin: left top; transform: skewX(-10deg); }
.pcol { position: absolute; left: 40dp; top: 28dp; width: 420dp; height: 668dp; display: flex; flex-direction: column; }
.ptags { font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #A9B4C2; }
.ptitle { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 62dp; line-height: 0.95em; text-transform: uppercase; margin-bottom: 10dp; }
.ptabs { display: flex; flex-direction: row; align-items: center; margin-bottom: 12dp; }
.ptabs .gcimg, .ptabs .gc, .ptabs .key { margin: 0dp 8dp 0dp 0dp; }
.ptb { height: 34dp; padding: 0dp 16dp; margin-right: 6dp; background-color: #2B3340; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; }
.ptb.on { background-color: #1F49C9; }
.ptb .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 19dp; text-transform: uppercase; letter-spacing: 1dp; }
.prows { display: flex; flex-direction: column; }
.pr { height: 40dp; margin-bottom: 5dp; padding-right: 12dp; background-color: #1D2430; display: flex; flex-direction: row; align-items: center; }
.pr.tight { height: 31dp; margin-bottom: 4dp; }
.pr.on { background-color: #F3F6FA; color: #12161C; }
/* the chosen row's mark: a straight bar down its whole left edge (it was
   a short slanted stroke, the owner, 2026-11-14: "fills the left edge in a
   straight line instead of a diagonal") */
.pcap { width: 6dp; height: 40dp; margin-right: 12dp; }
.pr.tight .pcap { height: 31dp; }
.pr.on .pcap { background-color: #1F49C9; }
.picon { width: 20dp; height: 20dp; margin-right: 12dp; image-color: #F3F6FA; }
.pr.on .picon { image-color: #12161C; }
.pl { font-size: 16dp; font-weight: 700; white-space: nowrap; }
.pr.tight .pl { font-size: 15dp; }
.pval { display: flex; flex-direction: row; align-items: center; font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; font-weight: 600; white-space: nowrap; }
.parr { width: 10dp; height: 10dp; margin: 0dp 7dp; image-color: #8A94A3; }
.pr.on .parr { image-color: #1F49C9; }
.pnav { display: flex; flex-direction: row; margin-top: 6dp; }
.pnb { flex: 1; height: 48dp; margin-right: 8dp; background-color: #2B3340; transform: skewX(-12deg); }
.pnb.right { margin-right: 0dp; }
.pnb.on { background-color: #F3F6FA; color: #12161C; }
.pnu { padding: 6dp 16dp 0dp 16dp; display: flex; flex-direction: column; }
.pnb.right .pnu { align-items: flex-end; }
.pnl { font-family: "IBM Plex Mono"; font-style: normal; font-size: 11dp; color: #A9B4C2; }
.pnb.on .pnl { color: #4A5361; }
.pnn { font-size: 15dp; font-weight: 700; white-space: nowrap; }
.phint { display: flex; flex-direction: row; align-items: center; font-size: 15dp; font-weight: 600; }
.phint div { margin-right: 18dp; }
.phint .key, .phint .gc, .phint .dpad, .phint .gcimg { margin-right: 8dp; }

/* the coach's card: over the picture, after misses in a row (the canvas's
   "Coach: what went wrong") */
.coach { display: none; position: absolute; left: 0dp; top: 0dp; width: 960dp; height: 720dp; }
.coach.on { display: block; }
.coach.mid { left: 160dp; }
.cdim { position: absolute; left: 0dp; top: 0dp; width: 960dp; height: 720dp; background-color: #05070AA3; }
.ccard { position: absolute; left: 36dp; top: 36dp; width: 888dp; height: 648dp; background-color: #E9EDF2; color: #12161C; display: flex; flex-direction: column; }
.chead { height: 72dp; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: row; align-items: center; padding-right: 24dp; }
.cstrip { width: 14dp; height: 72dp; background-color: #F5BE1B; margin-right: 16dp; }
.cbadge { width: 92dp; height: 30dp; background-color: #F5BE1B; color: #12161C; transform: skewX(-12deg); margin-right: 16dp; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.cbadge .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 20dp; text-transform: uppercase; letter-spacing: 1dp; }
.ctitle { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; text-transform: uppercase; line-height: 1em; white-space: nowrap; }
.cwhat { font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; color: #A9B4C2; text-align: right; line-height: 1.4em; margin-left: 12dp; white-space: nowrap; }
.cpanels { display: flex; flex-direction: row; padding: 14dp 24dp 0dp 24dp; }
.cpanel { width: 412dp; margin-right: 16dp; display: flex; flex-direction: column; }
.csec { font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; font-weight: 600; color: #4A5361; margin-bottom: 6dp; }
.csec.you { color: #F0643C; }
.csec.tgt { color: #18977F; }
.cpath { position: relative; width: 412dp; height: 236dp; background-color: #DCE2EA; overflow: hidden; clip: always; }
/* the game's own pictures of a try, played in the panel (Client.coach_play) */
.cpic { position: relative; width: 412dp; height: 236dp; background-color: #12161C; overflow: hidden; clip: always; }
.cpic.tall { height: 340dp; }
/* the input display over a panel (screens.pad_display) */
.pv { position: absolute; right: 6dp; bottom: 10dp; padding: 5dp 7dp; background-color: #12161CD9; }
.pvrow { display: flex; flex-direction: row; align-items: center; justify-content: center; }
.pvrow + .pvrow { margin-top: 4dp; }
.pvk { opacity: 0.22; margin: 0dp 2dp; }
.pvk.on { opacity: 1; }
.pv .gcimg { margin: 0dp; }
.pv .gcimg.a { height: 22dp; }
.pv .gcimg.b, .pv .gcimg.x, .pv .gcimg.y { height: 17dp; }
.pv .gcimg.l, .pv .gcimg.r { height: 14dp; }
.pv .gcimg.z { height: 11dp; }
.pvt { width: 26dp; height: 6dp; background-color: #4A5361; margin: 0dp 3dp; }
.pvf { height: 6dp; width: 0dp; background-color: #F3F6FA; }
.pvg { position: relative; width: 34dp; height: 34dp; border-radius: 17dp; border: 2dp #8A94A3; box-sizing: border-box; margin-right: 5dp; }
.pvg.c { width: 26dp; height: 26dp; border-radius: 13dp; border-color: #F5BE1B; }
.pvd { position: absolute; left: 10dp; top: 10dp; width: 10dp; height: 10dp; border-radius: 5dp; background-color: #F3F6FA; }
.pvg.c .pvd { left: 7dp; top: 7dp; width: 8dp; height: 8dp; border-radius: 4dp; background-color: #F5BE1B; }
.cpimg { position: absolute; }
.cfr { display: none; position: absolute; left: 8dp; top: 8dp; padding: 2dp 7dp; background-color: #12161CCC; color: #F3F6FA; font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; font-weight: 600; }
.cfr.on { display: block; }
.cptag { display: none; position: absolute; left: 8dp; bottom: 14dp; padding: 3dp 8dp; font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; font-weight: 600; white-space: nowrap; }
.cptag.on { display: block; }
.cptag.you { background-color: #F0643C; color: #FFFFFF; }
.cptag.tgt { background-color: #22B8A0; color: #12161C; }
.cbar { position: absolute; left: 0dp; right: 0dp; bottom: 0dp; height: 4dp; background-color: #12161C99; }
.cbarf { height: 4dp; width: 0dp; }
.cbarf.you { background-color: #F0643C; }
.cbarf.tgt { background-color: #22B8A0; }
.cbarf.ex { background-color: #22B8A0; }
.cptag.ex { background-color: #22B8A0; color: #12161C; }
.cpath.cnone { font-size: 14dp; color: #4A5361; padding: 100dp 24dp 0dp 24dp; box-sizing: border-box; text-align: center; }
.cfloor { position: absolute; left: 0dp; width: 412dp; height: 2dp; background-color: #8A94A3; }
.cdot { position: absolute; width: 7dp; height: 7dp; border-radius: 4dp; }
.cdot.cpu { background-color: #A9B4C2; }
.cdot.you.me { background-color: #F0643C; }
.cdot.you.ground { background-color: #B5452A; }
.cdot.tgt.me { background-color: #22B8A0; }
.cdot.tgt.ground { background-color: #18977F; }
.cdot.mark { width: 12dp; height: 12dp; border-radius: 6dp; background-color: #12161C; }
.ctag { position: absolute; font-family: "IBM Plex Mono"; font-style: normal; font-size: 11dp; font-weight: 600; padding: 2dp 6dp; white-space: nowrap; }
.ctag.you { background-color: #F0643C; color: #FFFFFF; }
.ctag.tgt { background-color: #22B8A0; color: #12161C; }
.ccap { font-size: 14dp; line-height: 1.3em; color: #3A4452; margin-top: 6dp; height: 36dp; overflow: hidden; }
.cmid { padding: 10dp 24dp 0dp 24dp; }
.cgrid { display: flex; flex-direction: column; }
.cgr { height: 22dp; margin-bottom: 3dp; display: flex; flex-direction: row; align-items: center; }
.cgrid.tight .cgr { height: 18dp; margin-bottom: 2dp; }
.cgrid.tight .cgc { height: 16dp; }
.cgrid.tight .cgn { font-size: 11dp; }
.cgl { width: 150dp; font-size: 14dp; font-weight: 700; white-space: nowrap; }
.cgc { flex: 1; height: 20dp; margin: 0dp 2dp; box-sizing: border-box; border: 1dp #C9D1DB; }
.cgn { border-width: 0dp 0dp 1dp 0dp; border-color: #A9B4C2; font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; color: #4A5361; text-align: center; }
.cgc.win { background-color: #CBD3DD; }
.cgc.perf { border: 2dp #22B8A0; }
.cgc.you { background-color: #12161C; }
.cgn.now { background-color: #F5BE1B; color: #12161C; }
.cbr { position: relative; height: 24dp; margin-left: 150dp; }
.cbrl { position: absolute; top: 2dp; height: 8dp; border-width: 0dp 2dp 2dp 2dp; border-color: #F0643C; }
.cbrt { position: absolute; top: 8dp; width: 120dp; text-align: center; font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; font-weight: 600; color: #F0643C; }
.cleg { display: flex; flex-direction: row; align-items: center; font-size: 12dp; color: #4A5361; margin-top: 2dp; }
.cleg .cgc { flex: none; width: 12dp; height: 12dp; margin: 0dp 6dp 0dp 0dp; }
.cleg div { margin-right: 14dp; }
.cfix { margin: 10dp 24dp 0dp 24dp; padding: 10dp 14dp; background-color: #FFFFFF; border-left: 6dp #22B8A0; display: flex; flex-direction: row; align-items: center; }
.cfixh { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 20dp; text-transform: uppercase; white-space: nowrap; margin-right: 16dp; }
.cfixt { font-size: 15dp; line-height: 1.3em; }
.cfoot { padding: 0dp 24dp 16dp 24dp; display: flex; flex-direction: row; align-items: center; font-size: 15dp; font-weight: 600; }
.ckey { display: flex; flex-direction: row; align-items: center; margin-right: 22dp; }
.ckey .gcimg, .ckey .gc, .ckey .key { margin-right: 8dp; }
.coff { font-size: 13dp; font-weight: 500; color: #4A5361; }

/* the tutorial: how to do it, shown (Client.tutorial): the coach card's
   frame, a teal head, the part's example played large, frame by frame */
.cstrip.tut { background-color: #22B8A0; }
.cbadge.tut { background-color: #22B8A0; width: 112dp; }
.tlead { padding: 10dp 24dp 0dp 24dp; font-size: 16dp; font-weight: 600; color: #3A4452; white-space: nowrap; overflow: hidden; }
.tmain { display: flex; flex-direction: row; padding: 10dp 24dp 0dp 24dp; }
.cpic.tpic { width: 520dp; height: 300dp; }
.cpath.tpic { width: 520dp; height: 300dp; }
.tside { flex: 1; margin-left: 18dp; display: flex; flex-direction: column; }
.th { font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; font-weight: 600; color: #18977F; margin-bottom: 4dp; text-transform: uppercase; }
.tcap { font-family: "Barlow Condensed"; font-weight: 700; font-size: 24dp; line-height: 1.15em; color: #12161C; height: 112dp; overflow: hidden; margin-bottom: 12dp; }
.ttext { font-size: 16dp; line-height: 1.35em; color: #12161C; margin-bottom: 12dp; }
.tcue { display: none; position: absolute; left: 0dp; right: 0dp; top: 34dp; padding: 8dp 12dp; font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 26dp; text-transform: uppercase; text-align: center; }
.tcue.on { display: block; }
.tcue.go { background-color: #22B8A0E6; color: #12161C; }
.tcue.late { background-color: #F0643CE6; color: #FFFFFF; }
.tcue.info { background-color: #12161CCC; color: #F3F6FA; }
.ttable { width: 520dp; height: 300dp; background-color: #FFFFFF; padding: 12dp 16dp; box-sizing: border-box; overflow: hidden; }
.trow { display: flex; flex-direction: row; align-items: center; padding: 5dp 0dp; border-bottom: 1dp #DCE2EA; }
.trow.mine { background-color: #E3F6F2; }
.tval { width: 44dp; font-family: "Barlow Condensed"; font-weight: 800; font-size: 28dp; text-align: center; color: #12161C; }
.tnames { flex: 1; font-size: 13dp; line-height: 1.3em; color: #3A4452; }
.tme { font-weight: 800; color: #12161C; }
.tchips { display: flex; flex-direction: row; padding: 10dp 24dp 0dp 24dp; }
.tchip { display: flex; flex-direction: row; align-items: center; height: 30dp; margin-right: 8dp; background-color: #FFFFFF; padding-right: 12dp; }
.tchip.now { background-color: #12161C; color: #F3F6FA; }
.tchip.done { color: #4A5361; }
.tpn { width: 30dp; height: 30dp; background-color: #DCE2EA; color: #12161C; font-family: "Barlow Condensed"; font-weight: 800; font-size: 18dp; text-align: center; line-height: 30dp; margin-right: 10dp; }
.tchip.now .tpn { background-color: #22B8A0; }
.tchip.done .tpn { background-color: #A9B4C2; }
.tpw { font-size: 14dp; font-weight: 700; white-space: nowrap; }

/* the replay of a try (the canvas's "Coach: replay of your try") */
.replay { display: none; position: absolute; left: 0dp; top: 0dp; width: 1280dp; height: 720dp; z-index: 10; color: #F3F6FA; }
.replay.on { display: block; }
.rtop { position: absolute; left: 24dp; top: 20dp; }
.rtitle { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 30dp; text-transform: uppercase; line-height: 1em; }
.rmode { font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; color: #D5DCE5; margin-top: 4dp; }
.rbottom { position: absolute; left: 24dp; top: 640dp; width: 912dp; }
.rscrub { height: 34dp; display: flex; flex-direction: row; }
.rs { flex: 1; margin-right: 3dp; height: 34dp; box-sizing: border-box; background-color: #1D2430E6; border: 1dp #2B3340; color: #8A94A3; font-family: "IBM Plex Mono"; font-style: normal; font-size: 11dp; text-align: center; line-height: 32dp; white-space: nowrap; overflow: hidden; }
.rs.you { background-color: #F0643C; color: #FFFFFF; }
.rs.tgt { border: 2dp #22B8A0; }
.rs.now { background-color: #F3F6FA; color: #12161C; }
.rleg { display: flex; flex-direction: row; align-items: center; margin-top: 6dp; font-size: 12dp; color: #D5DCE5; }
.rleg div { margin-right: 14dp; }
.rsw { width: 12dp; height: 12dp; margin-right: 6dp; box-sizing: border-box; }
.rsw.now { background-color: #F3F6FA; }
.rsw.you { background-color: #F0643C; }
.rsw.tgt { border: 2dp #22B8A0; }
.rcol { position: absolute; left: 960dp; top: 0dp; width: 320dp; height: 720dp; background-color: #12161C; }
.rhead { height: 120dp; padding: 18dp 22dp; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; }
.rhead .dname { font-size: 36dp; }
.rbody { position: absolute; left: 22dp; top: 138dp; width: 276dp; height: 560dp; display: flex; flex-direction: column; }
.rfr { align-items: flex-end; margin-bottom: 12dp; }
.rfn { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 44dp; line-height: 1em; margin-right: 10dp; }
.rof { font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #A9B4C2; margin-bottom: 6dp; }
.rpad { font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #F5BE1B; margin-bottom: 12dp; }
.rsay { font-size: 14dp; line-height: 1.35em; color: #D5DCE5; }
.rsay .ry { border-left: 4dp #F0643C; padding-left: 10dp; margin-bottom: 8dp; }
.rsay .rt { border-left: 4dp #22B8A0; padding-left: 10dp; margin-bottom: 8dp; }
.rcol .hints { display: flex; flex-direction: column; font-size: 14dp; font-weight: 600; }
.rcol .hintrow { display: flex; flex-direction: row; align-items: center; margin-top: 8dp; }
.now { color: #F3F6FA; font-weight: 700; margin-top: 4dp; }
.stageline { margin-bottom: 8dp; }

/* playing a friend online */
.onl { position: absolute; left: 0dp; top: 0dp; width: 1280dp; height: 720dp; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.onlbox { width: 640dp; }
.onlwhat { font-size: 15dp; margin: 2dp 0dp 12dp 0dp; color: #3A4452; }
.onlcode { background-color: #12161C; color: #F3F6FA; padding: 10dp 14dp; margin-bottom: 12dp; }
.onll { font-size: 12dp; letter-spacing: 1dp; color: #A9B4C2; }
.onlc { font-family: "IBM Plex Mono"; font-style: normal; font-size: 26dp; font-weight: 600; letter-spacing: 1dp; }
.onls { min-height: 22dp; margin-top: 10dp; font-size: 15dp; font-weight: 600; }

/* Versus: local or online */
#vlocal, #vonline { width: 556dp; }
#vlocal .in, #vonline .in { padding: 22dp 64dp 18dp 64dp; }
#vlocal .big, #vonline .big { font-size: 120dp; }

/* ---- settings (the canvas's Settings row) ---------------------------------- */

#scontrols { width: 556dp; }
#scontrols .in { padding: 22dp 64dp 18dp 64dp; }
#scontrols .big { font-size: 112dp; }
#scontrols .sub { font-size: 20dp; margin-top: 10dp; }
.tech .soon { border-color: #FFFFFF; }
.chips { height: 86dp; }
.chips .band .un { display: flex; flex-direction: column; align-items: center; }
.clbl { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 11dp; letter-spacing: 1dp; }
.cval { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 26dp; text-transform: uppercase; line-height: 1.05em; }
#sonline { height: 204dp; }
#sonline .in { padding: 18dp 40dp; }
#sonline .big { font-size: 76dp; }
#sonline .sub { font-size: 17dp; }
#ssound, #sdisplay { width: 270dp; }
#ssound .in, #sdisplay .in { padding: 18dp 40dp; }
#ssound .big, #sdisplay .big { font-size: 54dp; }
#ssound .sub, #sdisplay .sub { font-size: 16dp; margin-top: 8dp; }

/* Controls: the rows, and the one in focus edited beside them */
.slist { position: absolute; left: 48dp; top: 120dp; width: 420dp; height: 496dp; }
.srow { height: 54dp; margin-bottom: 8dp; box-sizing: border-box; padding: 0dp 18dp 0dp 12dp; background-color: #FFFFFF; border: 1dp #C9D1DB; display: flex; flex-direction: row; align-items: center; }
.srow.on { background-color: #12161C; color: #F3F6FA; border-color: #12161C; margin-right: -24dp; }
.srow.on .gl { color: #D5DCE5; }
.sv { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 14dp; white-space: nowrap; margin-left: 12dp; }
.spanel { position: absolute; left: 492dp; top: 120dp; width: 740dp; height: 496dp; box-sizing: border-box; padding: 22dp 26dp; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: column; overflow: hidden; }
.shd { display: flex; flex-direction: row; align-items: flex-end; margin-bottom: 14dp; }
.sed { font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #A9B4C2; }
.stl { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 52dp; line-height: 0.95em; text-transform: uppercase; }
.sright { font-size: 15dp; color: #D5DCE5; margin-bottom: 6dp; }

/* input delay */
.dly { display: flex; flex-direction: row; align-items: center; height: 150dp; }
.darr { width: 46dp; height: 112dp; background-color: #2B3340; color: #4A5361; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.darr.on { background-color: #F5BE1B; color: #12161C; }
.darr .un { font-family: "Barlow Condensed"; font-weight: 800; font-size: 36dp; }
.dnum { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 168dp; line-height: 1em; color: #F5BE1B; margin: 0dp 14dp 0dp 20dp; }
.dside { display: flex; flex-direction: column; margin-right: 20dp; }
.dword { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 56dp; line-height: 0.9em; text-transform: uppercase; }
.dms { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 14dp; color: #D5DCE5; margin-top: 6dp; }
.dnote { display: flex; flex-direction: column; align-items: flex-end; }
.dchip { background-color: #F5BE1B; color: #12161C; font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 12dp; padding: 4dp 10dp; }
.dsub { width: 170dp; margin-top: 8dp; font-size: 14dp; color: #A9B4C2; text-align: right; }
.lanes { margin-top: 10dp; }
.lane { height: 30dp; margin-bottom: 4dp; display: flex; flex-direction: row; align-items: center; }
.lane.nums { height: 18dp; }
.ll { width: 112dp; font-size: 14dp; font-weight: 600; color: #D5DCE5; }
.lc { flex: 1; height: 26dp; margin-right: 4dp; border: 1dp #2B3340; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.lc .un { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 10dp; }
.lc.n { height: 18dp; border-width: 0dp; }
.lc.n .un { font-size: 12dp; color: #A9B4C2; }
.lc.press { background-color: #F3F6FA; border-color: #F3F6FA; color: #12161C; }
.lc.held { background-color: #F5BE1B; border-color: #F5BE1B; }
.lc.move { background-color: #22B8A0; border-color: #22B8A0; color: #12161C; }
.lc.hit { background-color: #F0643C; border-color: #F0643C; color: #12161C; }
.lnote { margin-top: 6dp; font-size: 14dp; color: #A9B4C2; }

/* rumble */
.pcards { height: 280dp; }
.prow2 { height: 128dp; margin-bottom: 12dp; display: flex; flex-direction: row; }
.pcard { width: 338dp; height: 128dp; box-sizing: border-box; background-color: #1D2430; border: 3dp #00000000; display: flex; flex-direction: column; }
.pcard.l { margin-right: 12dp; }
.pcard.on { border-color: #F3F6FA; }
.pcard.nomotor { opacity: 0.55; }
.pband { height: 38dp; padding: 0dp 14dp; color: #12161C; display: flex; flex-direction: row; align-items: center; }
.pname { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 24dp; text-transform: uppercase; }
.psrc { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 11dp; }
.pbody { flex: 1; padding: 0dp 16dp; display: flex; flex-direction: row; align-items: center; }
.sw { width: 104dp; height: 40dp; box-sizing: border-box; padding: 0dp 5dp; background-color: #2B3340; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; justify-content: flex-start; }
.sw.on { background-color: #F3F6FA; justify-content: flex-end; }
.knob { width: 50dp; height: 30dp; background-color: #4A5361; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.knob .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 18dp; color: #12161C; }
.pst { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 12dp; color: #A9B4C2; }
.pst.go { color: #F5BE1B; }
.feel { display: flex; flex-direction: row; align-items: center; }
.feelbtn { height: 52dp; padding: 0dp 22dp; margin-right: 18dp; background-color: #F5BE1B; color: #12161C; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; }
.feelbtn .un { display: flex; flex-direction: row; align-items: center; font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 26dp; text-transform: uppercase; }
.feeltxt { font-size: 14dp; line-height: 1.35em; }
.feeltxt .dim2 { color: #A9B4C2; }

/* a setting that is on or off, and a note */
.sbig { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 96dp; line-height: 1em; text-transform: uppercase; color: #22B8A0; }
.sbig.off { color: #4A5361; }
.spara { width: 620dp; margin-top: 10dp; font-size: 17dp; line-height: 1.4em; color: #D5DCE5; }
.picks { display: flex; flex-direction: row; margin-top: 18dp; }
.pk { height: 38dp; padding: 0dp 22dp; margin-right: 10dp; border: 1dp #4A5361; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; }
.pk.on { background-color: #F3F6FA; color: #12161C; border-color: #F3F6FA; }
.pk .un { font-size: 17dp; font-weight: 700; }

/* sound: a meter for each volume, and what is playing */
.meters { height: 380dp; display: flex; flex-direction: row; }
.meter { width: 140dp; margin-right: 18dp; display: flex; flex-direction: column; }
.mv { height: 62dp; padding-left: 18dp; display: flex; flex-direction: row; align-items: flex-end; }
.mn { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 60dp; line-height: 1em; }
.mp { margin: 0dp 0dp 8dp 4dp; font-family: "IBM Plex Mono"; font-style: normal; font-size: 13dp; color: #A9B4C2; }
.mbar { flex: 1; margin: 8dp 0dp; padding: 6dp; box-sizing: border-box; background-color: #1D2430; border: 3dp #00000000; transform: skewX(-12deg); }
.meter.on .mbar { border-color: #F3F6FA; }
.mbar .un { transform: none; height: 100%; display: flex; flex-direction: column; }
.blk { flex: 1; margin-bottom: 4dp; }
.mlabel { padding: 6dp 12dp; color: #12161C; transform: skewX(-12deg); }
.ml1 { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 26dp; line-height: 1em; text-transform: uppercase; }
.ml2 { font-size: 12dp; font-weight: 600; }
.playing { flex: 1; height: 190dp; margin-left: 6dp; padding: 16dp 18dp; box-sizing: border-box; background-color: #1D2430; }
.song { margin-top: 6dp; font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 32dp; line-height: 1em; text-transform: uppercase; color: #F0643C; }
.spara2 { margin-top: 10dp; font-size: 14dp; line-height: 1.35em; color: #A9B4C2; }

/* display: where the game and the sidebar go */
.dscreen { height: 250dp; background-color: #05070A; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.dwin { width: 420dp; height: 236dp; border: 2dp #F5BE1B; display: flex; flex-direction: row; }
.dwin.mid { justify-content: center; }
.dgame { position: relative; width: 315dp; height: 236dp; background-color: #1B2233; }
.dlbl { padding: 6dp 8dp; font-family: "IBM Plex Mono"; font-style: normal; font-size: 11dp; color: #A9B4C2; }
.dstage { position: absolute; left: 40dp; top: 160dp; width: 235dp; height: 12dp; background-color: #8A94A3; }
.dside2 { flex: 1; padding: 8dp; background-color: #12161C; display: flex; flex-direction: column; }
.dside2 .dlbl { padding: 0dp; }
.dsb1 { height: 24dp; margin-bottom: 6dp; background-color: #1F49C9; }
.dsb2 { height: 6dp; margin-bottom: 6dp; background-color: #4A5361; }
.dsb2.short { width: 60dp; }
.dsb3 { height: 34dp; background-color: #2B3340; }

/* online: the nickname, friends */
.sbig.nick { font-size: 80dp; color: #F3F6FA; }
.fcard { height: 58dp; margin-bottom: 8dp; padding-right: 16dp; box-sizing: border-box; background-color: #1D2430; border: 3dp #00000000; display: flex; flex-direction: row; align-items: center; }
.fcard.on { border-color: #F3F6FA; }
.fini { width: 60dp; height: 52dp; margin-right: 14dp; background-color: #22B8A0; color: #12161C; transform: skewX(-12deg); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.fini .un { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 26dp; }
.fname { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 28dp; text-transform: uppercase; }
.fwhat { font-family: "IBM Plex Mono"; font-style: normal; font-size: 12dp; color: #A9B4C2; }

/* Versus, online: the code as a ticket, a paste button, friends as cards
   (the canvas's "Versus: online") */
.onl2 { position: absolute; left: 64dp; top: 118dp; width: 1168dp; height: 504dp; display: flex; flex-direction: row; }
.oleft { width: 590dp; margin-right: 34dp; display: flex; flex-direction: column; }
.ticket { position: relative; height: 230dp; background-color: #12161C; color: #F3F6FA; transform: skewX(-8deg); display: flex; flex-direction: row; }
.tring { position: absolute; left: -10dp; top: -10dp; right: -10dp; bottom: -10dp; border: 4dp #00000000; }
.ticket.on .tring { border-color: #12161C; }
.tbody { flex: 1; padding: 18dp 26dp; transform: skewX(8deg); display: flex; flex-direction: column; }
.tl { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 13dp; color: #A9B4C2; }
.tcode { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.tline { display: flex; flex-direction: row; }
.tg { margin-right: 18dp; font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 34dp; letter-spacing: 2dp; line-height: 1.25em; color: #F3F6FA; }
.tg.alt { color: #F5BE1B; }
.tsub { font-size: 15dp; color: #D5DCE5; }
/* (the ticket's perforation: not .perf, which the timelines' frame-perfect cells are) */
.tperfs { width: 10dp; padding: 10dp 0dp; display: flex; flex-direction: column; justify-content: space-between; }
.tperf { width: 10dp; height: 10dp; background-color: #E9EDF2; }
.tstub { width: 100dp; background-color: #22B8A0; color: #12161C; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.tadmit { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 30dp; line-height: 1em; text-align: center; }
.ostrip { height: 64dp; margin: 18dp 0dp 18dp 0dp; display: flex; flex-direction: row; }
.orouter { flex: 1; margin-right: 12dp; padding: 8dp 16dp; box-sizing: border-box; background-color: #FFFFFF; border: 2dp #12161C; display: flex; flex-direction: column; justify-content: center; }
.ort { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 24dp; line-height: 1em; text-transform: uppercase; }
.orw { font-size: 13dp; color: #4A5361; }
.odelay { width: 150dp; padding: 8dp 14dp; box-sizing: border-box; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: column; justify-content: center; }
.odv { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 28dp; line-height: 1em; color: #F5BE1B; }
.paste { height: 120dp; padding: 0dp 28dp; box-sizing: border-box; border: 3dp #12161C; transform: skewX(-8deg); display: flex; flex-direction: row; align-items: center; }
.paste.on { background-color: #12161C; color: #F3F6FA; }
.paste .un { transform: skewX(8deg); display: flex; flex-direction: column; }
.pbig { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 40dp; line-height: 1em; text-transform: uppercase; }
.psub { margin-top: 4dp; font-size: 15dp; color: #4A5361; }
.paste.on .psub { color: #D5DCE5; }
.oright { flex: 1; display: flex; flex-direction: column; }
.ofh { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 34dp; text-transform: uppercase; }
.sed.dk { color: #4A5361; }
.ofc { height: 76dp; margin-top: 10dp; box-sizing: border-box; background-color: #FFFFFF; border: 1dp #C9D1DB; transform: skewX(-8deg); display: flex; flex-direction: row; align-items: center; }
.ofc.on { background-color: #12161C; color: #F3F6FA; border-color: #12161C; }
.oini { width: 84dp; height: 74dp; margin-right: 18dp; color: #12161C; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.oini .un { transform: skewX(8deg); font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 32dp; }
.ofc .col { transform: skewX(8deg); }
.ofn { font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 28dp; line-height: 1em; text-transform: uppercase; }
.ofw { font-size: 13dp; color: #4A5361; }
.ofc.on .ofw { color: #D5DCE5; }
.ofnone { margin-top: 12dp; font-size: 16dp; line-height: 1.4em; color: #4A5361; width: 420dp; }

/* ---- the stage select (the canvas's "A · Stage select: grid and card") ---- */

/* Six panels, three to a row, cut to the slant as the character select's
   (.sgpic clips; .sgpin, slanted back, holds the picture upright). */
.sgrid { position: absolute; left: 60dp; top: 120dp; width: 754dp; height: 496dp; display: flex; flex-direction: column; }
.sgrow { height: 240dp; margin-bottom: 16dp; display: flex; flex-direction: row; flex-wrap: nowrap; }
.sg { position: relative; width: 238dp; height: 238dp; margin-right: 16dp; border: 1dp #12161C; background-color: #2B3340; transform: skewX(-12deg); }
.sg .ring { left: -8dp; top: -8dp; right: -8dp; bottom: -8dp; border-width: 5dp; }
.sgpic { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow: hidden; clip: always; }
.sgpin { position: absolute; left: -26dp; right: -26dp; top: 0dp; bottom: 0dp; transform: skewX(12deg); }
.sgimg { position: absolute; left: 0dp; top: 0dp; width: 290dp; height: 210dp; }
.sglogo { position: absolute; left: 33dp; top: 76dp; width: 224dp; height: 56dp; }
.sgstrip { position: absolute; left: 0dp; right: 0dp; bottom: 0dp; height: 30dp; background-color: #12161C; color: #F3F6FA; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.sgstrip .un { font-family: "Barlow Condensed"; font-weight: 700; font-size: 18dp; text-transform: uppercase; letter-spacing: 0.5dp; white-space: nowrap; }
/* The card: the stage whole, cut by the ink wedge (.wclip) as the
   character card's portrait is; the game's name logo; the numbers. */
.sgclip { position: absolute; left: 0dp; top: 0dp; width: 388dp; height: 218dp; overflow: hidden; clip: always; }
.sgprev { position: absolute; left: 0dp; top: 0dp; width: 388dp; height: 218dp; }
.sgname { position: absolute; left: 16dp; top: 214dp; width: 224dp; height: 56dp; }
.sgname2 { position: absolute; left: 26dp; top: 224dp; font-family: "Barlow Condensed"; font-weight: 800; font-style: italic; font-size: 34dp; text-transform: uppercase; }
.sgbody { position: absolute; left: 26dp; top: 278dp; width: 336dp; height: 198dp; display: flex; flex-direction: column; }
.sgstats { display: flex; flex-direction: row; }
.sgstats .stat .n { font-size: 32dp; }
.sgblast { margin-top: 8dp; padding-top: 6dp; border-top: 1dp #4A5361; }
.sgbz { display: flex; flex-direction: row; margin-top: 2dp; }
.sgb { flex: 1; }
.sgbn { font-family: "IBM Plex Mono"; font-style: normal; font-weight: 600; font-size: 15dp; }
.sgbl { font-size: 11dp; color: #A9B4C2; }
.sgabout { margin-top: 8dp; font-size: 14dp; line-height: 1.3em; color: #D5DCE5; }
