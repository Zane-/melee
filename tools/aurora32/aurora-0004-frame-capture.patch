 void aurora_set_present_hold(bool value) { aurora::g_presentHold = value; }
+void aurora_capture_enable(bool on) {
+  std::lock_guard<std::mutex> lock(aurora::g_captureMutex);
+  aurora::g_captureOn = on;
+  aurora::g_captureValid = false;
+}
+int aurora_capture_read(void (*sink)(const unsigned char*, unsigned, unsigned, unsigned, void*), void* ctx) {
+  using namespace aurora;
+  std::lock_guard<std::mutex> lock(g_captureMutex);
+  if (!g_captureOn || !g_captureValid || !g_captureBuffer) {
+    return -1;
+  }
+  const uint64_t size = static_cast<uint64_t>(g_captureStride) * g_captureHeight;
+  bool mapped = false;
+  const auto future = g_captureBuffer.MapAsync(
+      wgpu::MapMode::Read, 0, size, wgpu::CallbackMode::WaitAnyOnly,
+      [&mapped](wgpu::MapAsyncStatus status, wgpu::StringView) { mapped = status == wgpu::MapAsyncStatus::Success; });
+  if (webgpu::g_instance.WaitAny(future, 5000000000) != wgpu::WaitStatus::Success || !mapped) {
+    return -1;
+  }
+  const auto* data = static_cast<const unsigned char*>(g_captureBuffer.GetConstMappedRange(0, size));
+  const bool bgra = g_captureFormat == wgpu::TextureFormat::BGRA8Unorm ||
+                    g_captureFormat == wgpu::TextureFormat::BGRA8UnormSrgb;
+  std::vector<unsigned char> rgba(static_cast<size_t>(g_captureWidth) * 4 * g_captureHeight);
+  for (uint32_t y = 0; y < g_captureHeight; ++y) {
+    const unsigned char* row = data + static_cast<size_t>(y) * g_captureStride;
+    unsigned char* out = rgba.data() + static_cast<size_t>(y) * g_captureWidth * 4;
+    for (uint32_t x = 0; x < g_captureWidth; ++x) {
+      out[x * 4 + 0] = row[x * 4 + (bgra ? 2 : 0)];
+      out[x * 4 + 1] = row[x * 4 + 1];
+      out[x * 4 + 2] = row[x * 4 + (bgra ? 0 : 2)];
+      out[x * 4 + 3] = 255;
+    }
+  }
+  g_captureBuffer.Unmap();
+  sink(rgba.data(), g_captureWidth, g_captureHeight, g_captureWidth * 4, ctx);
+  return 0;
+}
