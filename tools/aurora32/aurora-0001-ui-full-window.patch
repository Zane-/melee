+void set_full_window(bool value) noexcept { s_fullWindow = value; }
+
+void set_frame(uint32_t width, uint32_t height) noexcept {
+  s_frameWidth = width;
+  s_frameHeight = height;
+}
+
+webgpu::Viewport frame_viewport(uint32_t width, uint32_t height) noexcept {
+  if (s_frameWidth == 0 || s_frameHeight == 0) {
+    return {
+        .left = 0.f,
+        .top = 0.f,
+        .width = static_cast<float>(width),
+        .height = static_cast<float>(height),
+        .znear = 0.f,
+        .zfar = 1.f,
+    };
+  }
+  return webgpu::calculate_present_viewport(width, height, s_frameWidth, s_frameHeight);
+}
+
+bool full_window() noexcept { return s_fullWindow; }
